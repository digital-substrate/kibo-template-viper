import "banner.stg"

pool(p) ::= <<
<preamble(p)>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<remote(p)>

} // namespace <p.model.namespace>::<p.name;format="lsc">

>>

preamble(p) ::= <<
// <p.name> -- the same pool, seen from a client.
//
<banner(p.model)>

#include "<p.include.remote>"

<p.dependencies.functions:{d|#include "<d.include.codec>"};separator="\n">

#include "<p.model.include.codec>"

#include "Viper_ServiceRemote.hpp"
#include "Viper_ValueVoid.hpp"
>>

remote(p) ::= <<
Remote::Remote(std::shared_ptr\<Viper::ServiceRemote> service)
: _service{std::move(service)} {}

bool Remote::isAvailable() const {
    return _service->queryFunctionPool(poolId) != nullptr;
}

<p.functions:remote_call(p);separator="\n\n">
>>

remote_call(f, p) ::= <<
<remote_head(f)>
<if(f.isVoid)>
    _service->call(poolId, "<f.dsmName>", {<f.parameters:{a|<p.model.namespace>::codec::encode(<a.name>)};separator=", ">});
<else>
    <remote_decode(f, p)>
        _service->call(poolId, "<f.dsmName>", {<f.parameters:{a|<p.model.namespace>::codec::encode(<a.name>)};separator=", ">}));
<endif>
}
>>

remote_decode(f, p) ::= <%return <p.model.namespace>::codec::decode\<<f.type>>(%>
remote_head(f) ::= <%<if(f.isVoid)>void<else><f.type><endif> Remote::<f.name>(<f.parameters:remote_param();separator=", ">) const {%>
remote_param(a) ::= <%<a.type><a.passBy> <a.name>%>
