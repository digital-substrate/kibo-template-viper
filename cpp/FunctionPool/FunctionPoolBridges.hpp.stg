// One file per pool. The scope is the pool's own name: `Tools`, not
// `Topology::FunctionPoolBridges::Tools` -- FunctionPoolBridges is the name of a
// template, and a template is a file, not a namespace level.
pool(p) ::= <<
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <p.model.generated>

#ifndef <p.name>_FunctionPoolBridges_hpp
#define <p.name>_FunctionPoolBridges_hpp

#include "<p.model.include.Data>"

#include "Viper_Values.hpp"

namespace <p.model.namespace>::<p.name;format="uf"> {

<p.functions:fp_prototype();separator="\n">

} // ns

#endif

>>

name(f) ::= <%<f.name;format="lsc">%>
function_parameter(p) ::= <%<p.type><p.passBy> <p.name>%>
function_parameters(f) ::= <%<f.parameters:function_parameter();separator=", ">%>
function_return(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
fp_prototype(f) ::= <%<f:function_return()> <f:name()>(<f:function_parameters()>);%>

