import "banner.stg"

unit(u) ::= <<
// <u.name> commit attachments -- the documents this namespace attaches to concepts, in a Commit database.
//
<banner(u.model)>
//
// The Commit usage: read a state, and write by emitting mutations (`set`, `diff`, the field
// mutations) that a commit records. One scope per attachment,
// `<u.model.namespace>::<u.name;format="lsc">::commit_attachments::\<Concept>::\<attachment>`. A concept declared in
// another namespace is spelled `\<Namespace>_\<Concept>` there, so that adding an attachment never
// renames another. A `Viper::Database` is the other usage: its own scopes, `database_attachments`.

#ifndef <u.guard.commit_attachments>
#define <u.guard.commit_attachments>

#include "<u.include.data>"
<u.dependencies.attachmentFields:{d|#include "<d.include.data>"};separator="\n">

#include "Viper_Attachment.hpp"
#include "Viper_AttachmentGetting.hpp"
#include "Viper_CommitAttachmentMutating.hpp"
#include "Viper_UUId.hpp"

#include \<map>

#include \<cstdint>
#include \<optional>
#include \<set>

<u.attachments:attachment(u);separator="\n\n">

#endif

>>

attachment(a, u) ::= <<
<if(a.hasDocumentation)>/** <a.documentation> */
<endif>namespace <u.model.namespace>::<u.name;format="lsc">::commit_attachments::<a.conceptScope>::<a.name> {

extern Viper::UUId const runtimeId;

std::shared_ptr\<Viper::Attachment> const & descriptor();

<keys(a)>

bool has(std::shared_ptr\<Viper::AttachmentGetting> const & state, <a.keyType.type> const & key);

<get(a)>

void set(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <a.documentType.type> const & value);

void diff(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <a.documentType.type> const & value,
          bool recursive = false);

<if(a.documentType.isStructure)>

<a.documentType.structure.fields:field(a);separator="\n">
<elseif(a.documentType.field.isNotBox)>

<a:document_aggregate()>
<endif>

} // namespace <u.model.namespace>::<u.name;format="lsc">::commit_attachments::<a.conceptScope>::<a.name>
>>

field(sf, a) ::= <<
void set<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <sf.type><sf.passBy> value);
<if(sf.field.isSet)><sf:field_set(a)><elseif(sf.field.isMap)><sf:field_map(a)><elseif(sf.field.isXArray)><sf:field_xarray(a)><endif>
>>

field_set(sf, a) ::= <<
void union<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <sf.type> const & value);
<field_subtract_set(sf, a)>
>>

field_map(sf, a) ::= <<
void union<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <sf.type> const & value);
<field_subtract_map(sf, a)>
void update<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <sf.type> const & value);
>>

field_xarray(sf, a) ::= <<
void insert<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, Viper::UUId const & beforePosition, Viper::UUId const & newPosition, <sf.field.elementType><sf.field.passBy> value);
void update<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, Viper::UUId const & position, <sf.field.elementType><sf.field.passBy> value);
void remove<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, Viper::UUId const & position);
>>

field_subtract_set(sf, a) ::= <<
<field_subtract_set_decl(sf, a)>
>>
field_subtract_set_decl(sf, a) ::= <%void subtract<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <sf.type> const & value);%>
field_subtract_map(sf, a) ::= <<
<field_subtract_map_decl(sf, a)>
>>
field_subtract_map_decl(sf, a) ::= <%void subtract<sf.name;format="uf">(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <sf.field.keySetType> const & value);%>

document_aggregate(a) ::= <<
<if(a.documentType.field.isSet)><a:document_set()><elseif(a.documentType.field.isMap)><a:document_map()><elseif(a.documentType.field.isXArray)><a:document_xarray()><endif>
>>

document_set(a) ::= <<
void union_(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <a.documentType.type> const & value);
void subtract(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <a.documentType.type> const & value);
>>

document_map(a) ::= <<
void union_(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <a.documentType.type> const & value);
<document_subtract_map(a)>
void update(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <a.documentType.type> const & value);
>>

document_subtract_map(a) ::= <%void subtract(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, <a.documentType.field.keySetType> const & value);%>

document_xarray(a) ::= <<
void insert(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, Viper::UUId const & beforePosition, Viper::UUId const & newPosition, <a.documentType.field.elementType><a.documentType.field.passBy> value);
void update(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, Viper::UUId const & position, <a.documentType.field.elementType><a.documentType.field.passBy> value);
void remove(std::shared_ptr\<Viper::CommitAttachmentMutating> const & state, <a.keyType.type> const & key, Viper::UUId const & position);
>>

keys(a) ::= <%std::set\<<a.keyType.type>> keys(std::shared_ptr\<Viper::AttachmentGetting> const & state);%>
get(a) ::= <%std::optional\<<a.documentType.type>> get(std::shared_ptr\<Viper::AttachmentGetting> const & state, <a.keyType.type> const & key);%>
