import "banner.stg"

unit(u) ::= <<
// <u.name> -- the implementation of the types declared here.
//
<banner(u.model)>

#include "<u.include.data>"

#include "<u.include.model>"
#include "<u.model.include.codec>"

#include \<utility>

namespace <u.model.namespace>::<u.name;format="lsc"> {

<u.concepts:concept(u);separator="\n\n">

<u.clubs:club(u);separator="\n\n">

<u.enumerations:enumeration(u);separator="\n\n">

<u.structures:structure(u);separator="\n\n">

} // namespace <u.model.namespace>::<u.name;format="lsc">

>>

concept(c, u) ::= <<

<c.name>Key::<c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept
: _instanceId{instanceId}, _runtimeId{runtimeId} {}

<c.name>Key::<c.name>Key() noexcept
: _runtimeId{runtime_ids::<c.name>} {}

<c.name>Key::<c.name>Key(Viper::UUId const & instanceId) noexcept
: _instanceId{instanceId}, _runtimeId{runtime_ids::<c.name>} {}

<c.name>Key <c.name>Key::create() { return {Viper::UUId::create(), runtime_ids::<c.name>}; }

Viper::UUId const & <c.name>Key::instanceId() const noexcept { return _instanceId; }
Viper::UUId const & <c.name>Key::runtimeId() const noexcept { return _runtimeId; }
bool <c.name>Key::isValid() const noexcept { return _instanceId.isValid(); }

std::string <c.name>Key::description() const { return <u.model.namespace>::codec::description(toAny()); }
bool <c.name>Key::isKnown() const { return <u.model.namespace>::codec::isKnown(toAny()); }
<if(c.parent)>

<c.strictAncestorsInNamespace:{a|<c.name>Key::operator <a.nameInNamespace>Key() const noexcept { return {_instanceId, _runtimeId\}; \}};separator="\n">

<c.parentNameInNamespace>Key <c.name>Key::toParentKey() const noexcept { return {_instanceId, _runtimeId}; }
<endif>

<u.model.namespace>::AnyConceptKey <c.name>Key::toAny() const noexcept { return {_instanceId, _runtimeId}; }
<u.model.namespace>::AnyConceptKey <c.name>Key::toAnyConceptKey() const noexcept { return toAny(); }
<c.strictDescendantsInNamespace:{d|<if(d.isLocal)>

std::optional\<<d.nameInNamespace>Key> <c.name>Key::as<d.asNameInNamespace>Key() const noexcept {
    return <d.nameInNamespace>Key::from(toAny());
\}<endif>}>

<narrowing_doc()>
<from(c, u, "conceptType")>

<comparisons(c)>

<key_hash(c)>
>>

club(c, u) ::= <<

<c.name>Key::<c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept
: _instanceId{instanceId}, _runtimeId{runtimeId} {}

<c.name>Key::<c.name>Key(Viper::UUId const & instanceId) noexcept
: _instanceId{instanceId}, _runtimeId{runtime_ids::<c.name>} {}

<c.membersInNamespace:club_constructor(c);separator="\n\n">

<c.membersInNamespace:club_getter(c);separator="\n\n">

Viper::UUId const & <c.name>Key::instanceId() const noexcept { return _instanceId; }
Viper::UUId const & <c.name>Key::runtimeId() const noexcept { return _runtimeId; }
bool <c.name>Key::isValid() const noexcept { return _instanceId.isValid(); }

std::string <c.name>Key::description() const { return <u.model.namespace>::codec::description(toAny()); }
bool <c.name>Key::isKnown() const { return <u.model.namespace>::codec::isKnown(toAny()); }

<u.model.namespace>::AnyConceptKey <c.name>Key::toAny() const noexcept { return {_instanceId, _runtimeId}; }
<u.model.namespace>::AnyConceptKey <c.name>Key::toAnyConceptKey() const noexcept { return toAny(); }

<narrowing_doc()>
<from(c, u, "clubType")>

<comparisons(c)>

<key_hash(c)>
>>

club_constructor(cm, c) ::= <<
<c.name>Key::<c.name>Key(<cm.nameInNamespace>Key const & key) noexcept
: _instanceId{key.instanceId()}, _runtimeId{key.runtimeId()} {}
>>

club_getter(cm, c) ::= <<
<club_getter_head(cm, c)>
    return <cm.nameInNamespace>Key::from(toAny());
}
>>

club_getter_head(cm, c) ::= <%std::optional\<<cm.nameInNamespace>Key> <c.name>Key::as<cm.asNameInNamespace>Key() const noexcept {%>

narrowing_doc() ::= <<
>>

from(c, u, descriptor) ::= <<
<from_head(c)>
    if (!<u.model.namespace>::codec::isMember(key, <descriptor>(Viper::StaticType::tag\<<c.name>Key>{})))
        return std::nullopt;

    return <c.name>Key{key.instanceId(), key.runtimeId()};
}
>>

from_head(c) ::= <%std::optional\<<c.name>Key> <c.name>Key::from(<u.model.namespace>::AnyConceptKey const & key) noexcept {%>

comparisons(c) ::= <<
bool operator==(<c.name>Key const & l, <c.name>Key const & r) noexcept {
    return l.instanceId() == r.instanceId() && l.runtimeId() == r.runtimeId();
}
bool operator!=(<c.name>Key const & l, <c.name>Key const & r) noexcept { return !(l == r); }
bool operator\<(<c.name>Key const & l, <c.name>Key const & r) noexcept {
    if (l.instanceId() != r.instanceId())
        return l.instanceId() \< r.instanceId();
    return l.runtimeId() \< r.runtimeId();
}
>>

key_hash(c) ::= <<
void hash(Viper::StaticHash::Hasher & h, <c.name>Key const & value) noexcept {
    hash(h, value.instanceId());
    hash(h, value.runtimeId());
}
>>

field_parameter(f) ::= <%<f.typeInNamespace><if(!f.isMovable)><f.passBy><endif> <f.name>%>
field_initialization(f) ::= <%<f.name>{<if(f.isMovable)>std::move(<f.name>)<else><f.name><endif>}%>

structure(s, u) ::= <<
<if(s.fields)>

<s.name>::<s.name>(<s.fields:field_parameter();separator=", ">)
: <s.fields:field_initialization();separator=", "> {}
<endif>

bool operator==(<s.name> const & l, <s.name> const & r) noexcept {
    return <s.fields:field_equal();separator="\n        && ">;
}
bool operator!=(<s.name> const & l, <s.name> const & r) noexcept { return !(l == r); }
bool operator\<(<s.name> const & l, <s.name> const & r) noexcept {
<trunc(s.fields):field_less();separator="\n">
    return Viper::StaticCompare::less(l.<last(s.fields).name>, r.<last(s.fields).name>);
}

void hash(Viper::StaticHash::Hasher & h, <s.name> const & value) noexcept {
<s.fields:field_hash();separator="\n">
}
>>

enumeration(e, u) ::= <<

void hash(Viper::StaticHash::Hasher & h, <e.name> value) noexcept {
    hash(h, static_cast\<std::uint8_t>(value));
}
>>

field_equal(f) ::= <%Viper::StaticCompare::equal(l.<f.name>, r.<f.name>)%>
field_less(f) ::= <<
    if (Viper::StaticCompare::less(l.<f.name>, r.<f.name>)) return true;
    if (Viper::StaticCompare::less(r.<f.name>, l.<f.name>)) return false;
>>
field_hash(f) ::= <<    hash(h, value.<f.name>);>>
