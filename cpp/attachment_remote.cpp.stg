import "banner.stg"

attachment_pool(p) ::= <<
<preamble(p)>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<attachment_remote(p)>

} // namespace <p.model.namespace>::<p.name;format="lsc">

>>

preamble(p) ::= <<
// <p.name> -- the same pool, seen from a client.
//
<banner(p.model)>

#include "<p.include.attachment_remote>"

<p.dependencies.functions:{d|#include "<d.include.codec>"};separator="\n">

#include "<p.model.include.codec>"

#include "Viper_ServiceRemote.hpp"
#include "Viper_ValueVoid.hpp"
>>

remote_decode(f, p) ::= <%return <p.model.namespace>::codec::decode\<<f.type>>(%>
remote_param(a) ::= <%<a.type><a.passBy> <a.name>%>

attachment_remote(p) ::= <<
Remote::Remote(std::shared_ptr\<Viper::ServiceRemote> service)
: _service{std::move(service)} {}

bool Remote::isAvailable() const {
    return _service->queryAttachmentFunctionPool(poolId) != nullptr;
}

<p.functions:attachment_remote_call(p);separator="\n\n">
>>

attachment_remote_call(f, p) ::= <<
<attachment_remote_head(f)>
<if(f.isVoid)>
    _service->call(attachment<f.interfaceType>, poolId, "<f.dsmName>", {<f.parameters:{a|<p.model.namespace>::codec::encode(<a.name>)};separator=", ">});
<else>
    <remote_decode(f, p)>
        _service->call(attachment<f.interfaceType>, poolId, "<f.dsmName>", {<f.parameters:{a|<p.model.namespace>::codec::encode(<a.name>)};separator=", ">}));
<endif>
}
>>

attachment_remote_head(f) ::= <%<if(f.isVoid)>void<else><f.type><endif> Remote::<f.name>(std::shared_ptr\<Viper::<f.interfaceName>> const & attachment<f.interfaceType><if(f.parameters)>, <f.parameters:remote_param();separator=", "><endif>) const {%>
