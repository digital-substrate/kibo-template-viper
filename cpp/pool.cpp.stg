pool(p) ::= <<
<preamble(p, "FunctionPool")>
#include "Viper_Function.hpp"

namespace <p.model.namespace>::<p.name;format="lsc"> {

namespace {

Viper::UUId const poolId{Viper::UUId::parse("<p.uuid>")};

<p.functions:function(p);separator="\n\n">

} // namespace

std::shared_ptr\<Viper::FunctionPool> pool() {
    static auto const instance = [] {
        auto const created = Viper::FunctionPool::make(poolId, "<p.name>", "<p.documentation;format="string">");
<p.functions:function_add();separator="\n">
        return created;
    }();
    return instance;
}

} // namespace <p.model.namespace>::<p.name;format="lsc">
>>

attachment_pool(p) ::= <<
<preamble(p, "AttachmentFunctionPool")>
#include "Viper_AttachmentGettingFunction.hpp"
#include "Viper_AttachmentMutatingFunction.hpp"

namespace <p.model.namespace>::<p.name;format="lsc"> {

namespace {

Viper::UUId const poolId{Viper::UUId::parse("<p.uuid>")};

<p.functions:attachment_function(p);separator="\n\n">

} // namespace

std::shared_ptr\<Viper::AttachmentFunctionPool> pool() {
    static auto const instance = [] {
        auto const created = Viper::AttachmentFunctionPool::make(poolId, "<p.name>", "<p.documentation;format="string">");
<p.functions:function_add();separator="\n">
        return created;
    }();
    return instance;
}

} // namespace <p.model.namespace>::<p.name;format="lsc">
>>

preamble(p, kind) ::= <<
// <p.name> -- the pool's bridge between the static and the dynamic world.
//
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <p.model.generated>

#include "<p.include.pool>"

<p.dependencies.functions:{d|#include "<d.include.codec>"};separator="\n">
<p.dependencies.functions:{d|#include "<d.include.model>"};separator="\n">

#include "<p.model.include.codec>"

#include "Viper_<kind>.hpp"
#include "Viper_FunctionPrototype.hpp"
#include "Viper_ValueVoid.hpp"
>>

function(f, p) ::= <<
class <f.name;format="uf"> final : public Viper::Function {
public:
    <make(f)>

    explicit <f.name;format="uf">(std::shared_ptr\<Viper::FunctionPrototype> prototype)
    : Viper::Function{std::move(prototype), "<f.documentation;format="string">"} {}

protected:
    <checked_call(f)>
<if(f.parameters)>
<f.parameters:{a|<a:decode(p, i0)>};separator="\n">

<endif>
<if(f.isVoid)>
        <f.name>(<f.parameters:{a|<a.name>};separator=", ">);
        return Viper::ValueVoid::Instance();
<else>
        return <p.model.namespace>::codec::encode(<f.name>(<f.parameters:{a|<a.name>};separator=", ">));
<endif>
    }
};
>>

attachment_function(f, p) ::= <<
class <f.name;format="uf"> final : public Viper::Attachment<f.interfaceType>Function {
public:
    <make(f)>

    explicit <f.name;format="uf">(std::shared_ptr\<Viper::FunctionPrototype> prototype)
    : Viper::Attachment<f.interfaceType>Function{std::move(prototype), "<f.documentation;format="string">"} {}

protected:
    <attachment_checked_call(f)>
<if(f.parameters)>
<f.parameters:{a|<a:decode(p, i0)>};separator="\n">

<endif>
<if(f.isVoid)>
        <f.name>(attachment<f.interfaceType><if(f.parameters)>, <f.parameters:{a|<a.name>};separator=", "><endif>);
        return Viper::ValueVoid::Instance();
<else>
        return <p.model.namespace>::codec::encode(<f.name>(attachment<f.interfaceType><if(f.parameters)>, <f.parameters:{a|<a.name>};separator=", "><endif>));
<endif>
    }
};
>>

decode(a, p, i) ::= <<
        <decode_body(a, p, i)>
>>
decode_body(a, p, i) ::= <%auto const <a.name>{<p.model.namespace>::codec::decode\<<a.type>>(args.at(<i>))};%>

make(f) ::= <<
<make_head(f)>
    <make_body(f)>
        "<f.name>",
        {<f.parameters:parameter();separator=",\n         ">},
        <return_type(f)>));
}
>>

make_head(f) ::= <%static std::shared_ptr\<<f.name;format="uf">> make() {%>
make_body(f) ::= <%return std::make_shared\<<f.name;format="uf">>(Viper::FunctionPrototype::make(%>

parameter(a) ::= <%{"<a.name>", type(Viper::StaticType::tag\<<a.type>>{})}%>
return_type(f) ::= <%<if(f.isVoid)>Viper::TypeVoid::Instance()<else>type(Viper::StaticType::tag\<<f.type>>{})<endif>%>

checked_call(f) ::= <<
<checked_call_head()>
        <checked_call_args()>
>>

checked_call_head() ::= <%std::shared_ptr\<Viper::Value> checkedCall(%>
checked_call_args() ::= <%std::vector\<std::shared_ptr\<Viper::Value>> const & args) const override {%>

attachment_checked_call(f) ::= <<
<checked_call_head()>
        <attachment_checked_call_interface(f)>
        <attachment_checked_call_args()>
>>

attachment_checked_call_interface(f) ::= <%std::shared_ptr\<Viper::Attachment<f.interfaceType>> const & attachment<f.interfaceType>,%>
attachment_checked_call_args() ::= <%std::vector\<std::shared_ptr\<Viper::Value>> const & args) const {%>

function_add(f) ::= <<        created->add(<f.name;format="uf">::make());>>
