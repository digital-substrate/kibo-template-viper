import "banner.stg"

unit(u) ::= <<
// <u.name> -- the types this namespace declares.
//
<banner(u.model)>

#ifndef <u.guard.data>
#define <u.guard.data>

<u.dependencies.types:{d|#include "<d.include.data>"};separator="\n">

#include "<u.model.include.any_concept>"

#include "Viper_StaticHash.hpp"
#include "Viper_Blob.hpp"
#include "Viper_UUId.hpp"

#include \<array>
#include \<cstdint>
#include \<map>
#include \<set>
#include \<string>
#include \<tuple>
#include \<variant>
#include \<vector>
#include \<functional>
#include \<optional>

namespace <u.model.namespace>::<u.name;format="lsc"> {

<u.concepts:{c|class <c.name>Key;};separator="\n">

<u.concepts:concept();separator="\n\n">

<u.clubs:club(u);separator="\n\n">

<u.enumerations:enumeration();separator="\n\n">

<u.sortedStructures:structure();separator="\n\n">

} // namespace <u.model.namespace>::<u.name;format="lsc">

<u.concepts:std_hash(u);separator="\n">
<u.clubs:std_hash(u);separator="\n">
<u.sortedStructures:std_hash_value(u);separator="\n">

#endif

>>

concept(c) ::= <<
<if(c.documentation)>/** <c.documentation> */
<endif>class <c.name>Key final {
public:
    <c.name>Key() noexcept;
    <c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept;

    explicit <c.name>Key(Viper::UUId const & instanceId) noexcept;

    static <c.name>Key create();

    Viper::UUId const & instanceId() const noexcept;
    Viper::UUId const & runtimeId() const noexcept;

    std::string description() const;
    bool isKnown() const;

    bool isValid() const noexcept;
<if(c.dsmConcept.parent)>
    operator <c.parentNameInNamespace>Key() const noexcept;

    <c.parentNameInNamespace>Key toParentKey() const noexcept;
<endif>
<c.strictDescendantsInNamespace:{d|<if(d.isLocal)>
    <concept_descendant_getter(d)><endif>}>

    <u.model.namespace>::AnyConceptKey toAny() const noexcept;
    <u.model.namespace>::AnyConceptKey toAnyConceptKey() const noexcept;
    static std::optional\<<c.name>Key> from(<u.model.namespace>::AnyConceptKey const & key) noexcept;

private:
    Viper::UUId _instanceId{};
    Viper::UUId _runtimeId{};
};

bool operator==(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator!=(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator\<(<c.name>Key const &, <c.name>Key const &) noexcept;

void hash(Viper::StaticHash::Hasher & h, <c.name>Key const & value) noexcept;
>>

club(c, u) ::= <<
<if(c.documentation)>/** <c.documentation> */
<endif>class <c.name>Key final {
public:
    <c.name>Key() = default;
    <c.name>Key(Viper::UUId const & instanceId, Viper::UUId const & runtimeId) noexcept;

    explicit <c.name>Key(Viper::UUId const & instanceId) noexcept;

<c.membersInNamespace:club_constructor(c);separator="\n">

<c.membersInNamespace:club_getter(c);separator="\n">

    Viper::UUId const & instanceId() const noexcept;
    Viper::UUId const & runtimeId() const noexcept;

    std::string description() const;
    bool isKnown() const;
    bool isValid() const noexcept;

    <u.model.namespace>::AnyConceptKey toAny() const noexcept;
    <u.model.namespace>::AnyConceptKey toAnyConceptKey() const noexcept;
    <club_from(c)>

private:
    Viper::UUId _instanceId{};
    Viper::UUId _runtimeId{};
};

bool operator==(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator!=(<c.name>Key const &, <c.name>Key const &) noexcept;
bool operator\<(<c.name>Key const &, <c.name>Key const &) noexcept;

void hash(Viper::StaticHash::Hasher & h, <c.name>Key const & value) noexcept;
>>

club_constructor(cm, c) ::= <<
    <c.name>Key(<cm.nameInNamespace>Key const & key) noexcept;>>

club_getter(cm, c) ::= <<
    <club_getter_body(cm)>
>>
club_getter_body(cm) ::= <%std::optional\<<cm.nameInNamespace>Key> as<cm.asNameInNamespace>Key() const noexcept;%>

concept_descendant_getter(d) ::= <%std::optional\<<d.nameInNamespace>Key> as<d.asNameInNamespace>Key() const noexcept;%>

club_from(c) ::= <%static std::optional\<<c.name>Key> from(<u.model.namespace>::AnyConceptKey const & key) noexcept;%>

structure(s) ::= <<
<if(s.documentation)>/** <s.documentation> */
<endif>struct <s.name> final {
<s.fields:field();separator="\n">
};

bool operator==(<s.name> const &, <s.name> const &) noexcept;
bool operator!=(<s.name> const &, <s.name> const &) noexcept;
bool operator\<(<s.name> const &, <s.name> const &) noexcept;

void hash(Viper::StaticHash::Hasher & h, <s.name> const & value) noexcept;
>>

field(f) ::= <<    <f.typeInNamespace> <f.name><f.defaultValue>;>>

enumeration(e) ::= <<
<if(e.documentation)>/** <e.documentation> */
<endif>enum class <e.name> {
<e.members:enumeration_case();separator=",\n">
};

void hash(Viper::StaticHash::Hasher & h, <e.name> value) noexcept;
>>

enumeration_case(m) ::= <<
    <m.name;format="uf">
>>

std_hash(e, u) ::= <<
<std_hash_head(e, u)>
    std::size_t operator()(<u.model.namespace>::<u.name;format="lsc">::<e.name>Key const & v) const noexcept { return Viper::StaticHash::of(v); }
};
>>

std_hash_head(e, u) ::= <%template\<> struct std::hash\<<u.model.namespace>::<u.name;format="lsc">::<e.name>Key> {%>

std_hash_value(e, u) ::= <<
<std_hash_value_head(e, u)>
    std::size_t operator()(<u.model.namespace>::<u.name;format="lsc">::<e.name> const & v) const noexcept { return Viper::StaticHash::of(v); }
};
>>

std_hash_value_head(e, u) ::= <%template\<> struct std::hash\<<u.model.namespace>::<u.name;format="lsc">::<e.name>> {%>
