import "banner.stg"

unit(u) ::= <<
// <u.name> paths -- the path of every field of its structures, for code that reads or writes a
// field through the dynamic API. The field names are in the fields header.
//
<banner(u.model)>

#ifndef <u.guard.paths>
#define <u.guard.paths>

#include "Viper_Path.hpp"

#include \<memory>

<u.structures:structure(u);separator="\n\n">

#endif

>>

structure(s, u) ::= <<
namespace <u.model.namespace>::<u.name;format="lsc">::paths::<s.name> {

<s.fields:path();separator="\n">

} // namespace <u.model.namespace>::<u.name;format="lsc">::paths::<s.name>
>>

path(f) ::= <<std::shared_ptr\<Viper::Path const> const & <f.name>();>>
