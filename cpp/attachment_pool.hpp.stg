import "banner.stg"

attachment_pool(p) ::= <<
<preamble(p, "AttachmentFunctionPool", "yes")>

namespace <p.model.namespace>::<p.name;format="lsc"> {

#ifndef <p.guard.attachment_pool>_IDENTITY
#define <p.guard.attachment_pool>_IDENTITY
inline constexpr std::string_view poolName{"<p.dsmName>"};
inline Viper::UUId const poolId{Viper::UUId::parse("<p.uuid>")};
#endif

<p.functions:attachment_bridge();separator="\n">

<pool_doc(p)>std::shared_ptr\<Viper::AttachmentFunctionPool> pool();

} // namespace <p.model.namespace>::<p.name;format="lsc">

#endif

>>

preamble(p, kind, context) ::= <<
// <p.name> -- an attachment pool: the functions over a Commit state the application implements, and the pool.
//
<banner(p.model)>

#ifndef <p.guard.attachment_pool>
#define <p.guard.attachment_pool>

<p.dependencies.functions:{d|#include "<d.include.data>"};separator="\n">

#include "Viper_<kind>.hpp"
#include "Viper_Any.hpp"
#include "Viper_Blob.hpp"
#include "Viper_BlobId.hpp"
#include "Viper_CommitId.hpp"
#include "Viper_UUId.hpp"
#include "Viper_XArray.hpp"
<if(context)>

#include "Viper_AttachmentGetting.hpp"
#include "Viper_CommitAttachmentMutating.hpp"
<endif>

#include \<cstdint>
#include \<memory>
#include \<string_view>
>>

doc(f) ::= <<
<if(f.hasDocumentation)>/** <f.documentation;format="comment"> */
<endif>
>>

attachment_bridge(f) ::= <<
<doc(f)><ret(f)> <f.name>(std::shared_ptr\<Viper::<f.interfaceName>\> const & attachment<f.interfaceType><if(f.parameters)>, <f.parameters:param();separator=", "><endif>);
>>

ret(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
param(p) ::= <%<p.type><p.passBy> <p.name>%>

pool_doc(p) ::= <<
<if(p.hasDocumentation)>/** <p.documentation;format="comment"> */
<endif>
>>
