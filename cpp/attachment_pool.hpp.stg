import "banner.stg"

model(m) ::= <<
// <m.namespace> attachment pool -- the model's attachments, exposed to the dynamic world.
//
<banner(m)>

#ifndef <m.guard.attachment_pool>
#define <m.guard.attachment_pool>

#include "Viper_AttachmentFunctionPool.hpp"

#include \<memory>

namespace <m.namespace> {

std::shared_ptr\<Viper::AttachmentFunctionPool> attachment_pool();

} // namespace <m.namespace>

#endif

>>
