import "banner.stg"

model(m) ::= <<
// <m.namespace>::AnyConceptKey -- its codec and hash.
//
<banner(m)>

#include "<m.include.any_concept>"

#include "Viper_StreamReading.hpp"
#include "Viper_StreamWriting.hpp"
#include "Viper_TypeAnyConcept.hpp"

namespace <m.namespace> {

void hash(Viper::StaticHash::Hasher & h, AnyConceptKey const & value) noexcept {
    hash(h, value.instanceId());
    hash(h, value.runtimeId());
}

void write(Viper::StaticWriter::Writer & w, AnyConceptKey const & value) {
    write(w, value.instanceId());
    write(w, value.runtimeId());
}

AnyConceptKey read(Viper::StaticReader::Reader & r, Viper::StaticType::tag\<AnyConceptKey>) {
    auto const instanceId{read(r, Viper::StaticType::tag\<Viper::UUId>{})};
    auto const runtimeId{read(r, Viper::StaticType::tag\<Viper::UUId>{})};

    return {instanceId, runtimeId};
}

std::shared_ptr\<Viper::Type> const & type(Viper::StaticType::tag\<AnyConceptKey>) {
    static std::shared_ptr\<Viper::Type> const instance{Viper::TypeAnyConcept::InstanceTypeKey()};
    return instance;
}

} // namespace <m.namespace>

>>
