import "banner.stg"

unit(u) ::= <<
// <u.name> database attachments -- the implementation of the attachments declared here, over a Viper::Database.
//
<banner(u.model)>

#include "<u.include.database_attachments>"

#include "<u.include.codec>"
#include "<u.include.model>"
<u.dependencies.attachments:{d|#include "<d.include.codec>"};separator="\n">
<u.dependencies.attachments:{d|#include "<d.include.model>"};separator="\n">

#include "<u.model.include.codec>"

#include "Viper_Attachment.hpp"
#include "Viper_Definitions.hpp"
#include "Viper_Values.hpp"
#include "Viper_ValueSetIter.hpp"

<u.attachments:attachment(u);separator="\n\n">

>>

attachment(a, u) ::= <<
namespace <u.model.namespace>::<u.name;format="lsc">::database_attachments::<a.conceptScope>::<a.name> {

Viper::UUId const runtimeId{Viper::UUId::parse("<a.runtimeId>")};

std::shared_ptr\<Viper::Attachment> const & descriptor() {
    static auto const instance = <u.model.namespace>::codec::definitions()->checkAttachment(runtimeId);
    return instance;
}

namespace {

std::shared_ptr\<Viper::Attachment> const & attachment() { return descriptor(); }

<encode_key(a, u)>

} // namespace

<keys(a, u)>

bool has(std::shared_ptr\<Viper::Database const> const & database, <a.keyType.type> const & key) {
    return database->has(attachment(), encodeKey(key));
}

<get(a, u)>

bool set(std::shared_ptr\<Viper::Database> const & database, <a.keyType.type> const & key, <a.documentType.type> const & value) {
    return database->set(attachment(), encodeKey(key), <u.model.namespace>::codec::encode(value));
}

bool del(std::shared_ptr\<Viper::Database> const & database, <a.keyType.type> const & key) {
    return database->del(attachment(), encodeKey(key));
}

} // namespace <u.model.namespace>::<u.name;format="lsc">::database_attachments::<a.conceptScope>::<a.name>
>>

encode_key(a, u) ::= <<
<encode_key_head(a)>
    return <u.model.namespace>::codec::encode(key);
}
>>

encode_key_head(a) ::= <%std::shared_ptr\<Viper::ValueKey> encodeKey(<a.keyType.type> const & key) {%>

keys(a, u) ::= <<
<keys_head(a)>
    <keys_result(a)>
    for (Viper::ValueSetIter it{database->keys(attachment())}; it.hasNext(); it.next())
        result.insert(<decode_call(a.keyType.type, u)>(it.value()));

    return result;
}
>>

keys_head(a) ::= <%std::set\<<a.keyType.type>> keys(std::shared_ptr\<Viper::Database const> const & database) {%>
keys_result(a) ::= <%std::set\<<a.keyType.type>> result;%>

get(a, u) ::= <<
<get_head(a)>
    auto const document = database->get(attachment(), encodeKey(key));
    if (document->isNil())
        return std::nullopt;

    return <decode_call(a.documentType.type, u)>(document->unwrap());
}
>>

get_head(a) ::= <%std::optional\<<a.documentType.type>> get(std::shared_ptr\<Viper::Database const> const & database, <a.keyType.type> const & key) {%>

decode_call(type, u) ::= <%<u.model.namespace>::codec::decode\<<type>>%>
