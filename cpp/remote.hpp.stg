pool(p) ::= <<
<preamble(p, "")>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<remote(p)>

} // namespace <p.model.namespace>::<p.name;format="lsc">

#endif
>>

attachment_pool(p) ::= <<
<preamble(p, "yes")>

namespace <p.model.namespace>::<p.name;format="lsc"> {

<attachment_remote(p)>

} // namespace <p.model.namespace>::<p.name;format="lsc">

#endif
>>

preamble(p, context) ::= <<
// <p.name> -- the same pool, seen from a client.
//
