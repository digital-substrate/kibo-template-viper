// One file per pool. The remote proxy is `Remote` inside the pool's own scope --
// Tools::Remote, not Topology::FunctionPoolRemotes::Tools -- so the client side and the
// local side of one pool sit in the same unit, and neither carries a template's name.
pool(p) ::= <<
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <p.model.generated>

#include "<p.include.FunctionPoolRemotes>"
#include "<p.model.include.ValueDecoder>"
#include "<p.model.include.ValueEncoder>"

#include "Viper_ServiceRemote.hpp"

namespace <p.name;format="uf"> {

<p:fp()>

} // ns
>>

// Function Data
function_parameter(p) ::= <%<p.type><p.passBy> <p.name>%>
function_parameters(f) ::= <%<if(f.parameters)><f.parameters:function_parameter();separator=", "><endif>%>
function_return(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>

fp_parameter_push_back(p) ::= <%parameters.push_back(ValueEncoder::encode<p.typeSuffix>(<p.name>));%>
fp_function(f,po) ::= <<
<f:function_return()> Remote::<f.name;format="lsc">(<f:function_parameters()>) const {
    static std::string const funcName("<f.name;format="lsc">");

    std::vector\<std::shared_ptr\<Viper::Value\>> parameters;
    <f.parameters:fp_parameter_push_back();separator="\n">

    <if(f.isVoid)>
    serviceRemote->call(poolId, funcName, parameters);
    <else>
    auto const value{serviceRemote->call(poolId, funcName, parameters)};
    auto const result{Viper::<f.returnViperValue>::cast(value)};
    return ValueDecoder::decode<f.typeSuffix>(result);
    <endif>
}

>>

fp(po) ::= <<
Viper::UUId const Remote::poolId{Viper::UUId::parse("<po.uuid>")};

Remote::Remote(std::shared_ptr\<Viper::ServiceRemote> const & serviceRemote)
: serviceRemote{serviceRemote} {}

bool Remote::isAvailable() const {
    return serviceRemote->queryFunctionPool(poolId) != nullptr;
}

<po.functions:fp_function(po);separator="\n">

>>

