// One file per pool. The remote proxy is `Remote` inside the pool's own scope --
// Tools::Remote, not Topology::FunctionPoolRemotes::Tools -- so the client side and the
// local side of one pool sit in the same unit, and neither carries a template's name.
pool(p) ::= <<
// Generated by kibo from <p.model.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 2.0.0 (MIT), Template Model 2.
// Runtime: this file links against the `viper` C++ runtime 1.2.x,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <p.model.generated>

#ifndef <p.name>_FunctionPoolRemotes_hpp
#define <p.name>_FunctionPoolRemotes_hpp

#include "<p.model.include.Data>"

#include "Viper_ServiceRemote.hpp"

namespace <p.name;format="uf"> {

<p:fp()>

} // ns

#endif

>>

function_parameter(p) ::= <%<p.type><p.passBy> <p.name>%>
function_parameters(f) ::= <%<if(f.parameters)><f.parameters:function_parameter();separator=", "><endif>%>
function_return(f) ::= <%<if(f.isVoid)>void<else><f.type><endif>%>
fp_prototype(f) ::= <%<f:function_return()> <f.name;format="lsc">(<f:function_parameters()>) const;%>

fp(po) ::= <<
// MARK: - <po.name>
class Remote {
public:
    static Viper::UUId const poolId;
    std::shared_ptr\<Viper::ServiceRemote> const serviceRemote;

    explicit Remote(std::shared_ptr\<Viper::ServiceRemote> const & serviceRemote);

    bool isAvailable() const;

    <po.functions:fp_prototype();separator="\n">
};

>>

