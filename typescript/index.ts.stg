import "banner.stg"

model(m) ::= <<
<preamble(m)>
/**
 * The <m.namespace> model, generated over `@digitalsubstrate/dsviper`.
 *
 * Each DSM namespace is a namespace of this module holding its structures, enumerations and
 * keys, and its attachments as `attachments`:
 * <m.nameSpaces:{u|`<u.name;format="snake">`};separator=", ">.
 * One class per container shape the model uses, in a structure, an attachment or a pool, is
 * exported here; another shape is built with the runtime, from Viper values:
 * `dsviper.Value.create(new dsviper.TypeSet(<if(m.concepts)><first(m.concepts):{c|<c.namespace;format="snake">.<c.name>Key}><else>Cls<endif>.type()), keys.map((k) => k.unwrapValue()))`.
 * `definitions()` is the model.<if(m.functionPools || m.attachmentFunctionPools)>
 * The pools, rendered with the Pool feature, are imported from `<m.namespace;format="snake">/pools`:
 * <[m.functionPools, m.attachmentFunctionPools]:{p|`<p.name;format="snake">`};separator=", ">.<endif>

 *
 * A document is stored in a dsviper database that knows the model, and read and written
 * through an attachment, given the database or a state:
 *
 * ```ts
 * import dsviper from "@digitalsubstrate/dsviper";
 * import { definitions, <if(m.attachments)><first(m.attachments):{a|<a.namespace;format="snake">}><else><first(m.nameSpaces):{u|<u.name;format="snake">}><endif> } from "<m.namespace;format="snake">";
 *
 * const db = dsviper.Database.createInMemory();   // a CommitDatabase keeps every commit
 * db.extendDefinitions(definitions());
 * db.beginTransaction();
 * <if(m.attachments)><first(m.attachments):{a|<a.namespace;format="snake">.attachments.<a.conceptScope>.<a.name;format="lf">}><else><first(m.nameSpaces):{u|<u.name;format="snake">}>.attachments.Concept.attachment<endif>.set(db, key, document);
 * db.commit();
 * ```
 *
 * A generated object is a box around a Viper value: `p.unwrapValue()` gives it, and
 * `Cls.wrapValue(value)` boxes one. A runtime feature is called on that value: bytes are
 * `dsviper.Value.encode(p.unwrapValue())`, read back with
 * `Cls.wrapValue(dsviper.Value.decode(blob, Cls.type(), definitions()))`. wrapValue or a
 * constructor given a Viper value of another type throws TypeError; the rest is the runtime's
 * to refuse, with dsviper.ViperError: content that does not fit, native or generated, in a
 * field, a container or an attachment.
 *
 * This package and the code that opens a database must reach one installation of the
 * runtime, so the package declares `@digitalsubstrate/dsviper` as a peer dependency: the
 * project owns it and imports it as its own, npm installs one copy and refuses a range this
 * package does not accept. A second copy of the native binding refuses to load.
 *
 * @packageDocumentation
 */
export { definitions } from "./definitions.js";
export * from "./containers.js";
export { AnyConceptKey, AnyValue } from "./_codegen/registry.js";
export { Key } from "./_codegen/proxy.js";
export type { AttachmentProxy } from "./_codegen/attachment.js";
<m.nameSpaces:{u|export * as <u.name;format="snake"> from "./<u.name;format="snake">/index.js";};separator="\n">

>>

unit(u) ::= <<
<preamble(u.model)>
export * from "./data.js";
export * as attachments from "./attachments.js";

>>

preamble(m) ::= <<
<banner(m)>

>>
