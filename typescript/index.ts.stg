import "banner.stg"

model(m) ::= <<
<preamble(m)>
export { definitions } from "./definitions.js";
export * from "./containers.js";
export { AnyConceptKey, AnyValue } from "./_codegen/registry.js";
export { Key } from "./_codegen/proxy.js";
<m.nameSpaces:{u|export * as <u.name;format="snake"> from "./<u.name;format="snake">/index.js";};separator="\n">

>>

unit(u) ::= <<
<preamble(u.model)>
export * from "./data.js";
export * as attachments from "./attachments.js";

>>

preamble(m) ::= <<
<banner(m)>

>>
