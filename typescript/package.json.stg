model(m) ::= <<
{
    "name": "<m.namespace;format="snake">",
    "version": "1.0.0",
    "description": "TypeScript bindings generated by kibo for the <m.namespace> model",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./pools": {
            "types": "./dist/pools.d.ts",
            "import": "./dist/pools.js"
        },
        "./attachment_pools": {
            "types": "./dist/attachment_pools.d.ts",
            "import": "./dist/attachment_pools.js"
        },
        "./*/database_attachments": {
            "types": "./dist/*/database_attachments.d.ts",
            "import": "./dist/*/database_attachments.js"
        },
        "./*/commit_attachments": {
            "types": "./dist/*/commit_attachments.d.ts",
            "import": "./dist/*/commit_attachments.js"
        },
        "./*/fields": {
            "types": "./dist/*/fields.d.ts",
            "import": "./dist/*/fields.js"
        },
        "./*/paths": {
            "types": "./dist/*/paths.d.ts",
            "import": "./dist/*/paths.js"
        },
        "./*": {
            "types": "./dist/*/index.d.ts",
            "import": "./dist/*/index.js"
        }
    },
    "files": ["dist", "src"],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@digitalsubstrate/dsviper": ">=1.2.16 \<1.3.0"
    },
    "devDependencies": {
        "@digitalsubstrate/dsviper": ">=1.2.16 \<1.3.0",
        "@types/node": ">=20",
        "typescript": ">=5"
    },
    "license": "UNLICENSED"
}

>>
