model(m) ::= <<
{
    "name": "<m.namespace;format="lsc">",
    "version": "1.0.0",
    "description": "TypeScript bindings generated by kibo for the <m.namespace> model",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": ["dist", "src"],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@digitalsubstrate/dsviper": ">=1.2.13 \<1.3.0"
    },
    "devDependencies": {
        "@types/node": ">=20",
        "typescript": ">=5"
    },
    "license": "UNLICENSED"
}
>>
