// Native primitives that must be wrapped into a Value before the RPC call.
dtype(t) ::= <%<if(t.useProxy)>d.<t.proxy><else><t.type><endif>%>
dwrap(t, e) ::= <%<if(t.useProxy)>d.<t.proxy>.wrap(<e>)<else><e> as <t.type><endif>%>
parameter(p) ::= <%<p.name>: <p.bindingType:dtype()>%>
encodeArg(p) ::= <%<if(p.bindingType.useProxy)><p.name>.vprValue<else><p.name><endif>%>

pool(po) ::= <<
// <po.name>
export class <po.name;format="uf"> {

    private readonly serviceRemote: dsviper.ServiceRemote;

    constructor(serviceRemote: dsviper.ServiceRemote) {
        this.serviceRemote = serviceRemote;
    }

    isAvailable(): boolean {
        return this.serviceRemote.functionPoolFuncs("<po.name>") !== undefined;
    }

    <po.functions:fp_function(po);separator="\n">
}

>>

fp_function(f, po) ::= <<
<f.name;format="lsc">(<f.parameters:parameter();separator=", ">): <f.returnBindingType:dtype()> {
    <if(f.isVoid)>
    this.serviceRemote.functionPoolFunc("<po.name>", "<f.name;format="lsc">").call(<f.parameters:encodeArg();separator=", ">);
    <else>
    const result = this.serviceRemote.functionPoolFunc("<po.name>", "<f.name;format="lsc">").call(<f.parameters:encodeArg();separator=", ">);
    return <f.returnBindingType:dwrap("result")>;
    <endif>
}
>>
