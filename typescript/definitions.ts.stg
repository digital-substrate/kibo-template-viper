main(m) ::= <<
// Generated by kibo from <m.namespace>. Do not edit by hand.
// Templates: kibo-template-viper 1.2.3 (MIT).
// Runtime: this file imports `@digitalsubstrate/dsviper`,
// distributed under LicenseRef-DigitalSubstrate-Commercial-1.2.
// Commercial use requires a Commercial Licence from Digital Substrate.
// <m.generated>

/**
 * Viper Definitions and runtime ids for <m.namespace>.
 */

import dsviper from "@digitalsubstrate/dsviper";
import { B64_DEFINITIONS } from "./resources.js";

let _definitions: dsviper.DefinitionsConst | null = null;

export function definitions(): dsviper.DefinitionsConst {
    if (_definitions === null) {
        const blob = dsviper.ValueBlob.base64Decode(B64_DEFINITIONS);
        const defs = dsviper.Definitions.decode(blob);
        _definitions = defs.const();
    }
    return _definitions;
}

// Concept / club / enum / struct runtime ids
export const RuntimeIds = {
<m.nameSpaces:namespace_runtime_id();separator="\n">
};

// Attachment runtime ids
export const AttachmentRuntimeIds = {
<m.nameSpaces:namespace_attachment_runtime_id();separator="\n">
};
>>

namespace_runtime_id(ns) ::= <<
    // Namespace <ns.name>
    <ns.concepts:runtime_id();separator="\n">
    <ns.clubs:runtime_id();separator="\n">
    <ns.enumerations:runtime_id();separator="\n">
    <ns.structures:runtime_id();separator="\n">
>>

namespace_attachment_runtime_id(ns) ::= <<
    // Namespace <ns.name>
    <ns.attachments:attachment_runtime_id();separator="\n">
>>

runtime_id(v) ::= <%<v.pythonType.proxy>: dsviper.ValueUUId.create("<v.runtimeId>"),%>
attachment_runtime_id(a) ::= <%<a.namespace>_<a.identifier>: dsviper.ValueUUId.create("<a.runtimeId>"),%>
