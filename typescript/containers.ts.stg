named(u) ::= <<
<u.concepts:{c|const type_<u.name>_<c.name>Key = () => <u.name;format="lsc">.<c.name>Key.type();};separator="\n">
<u.clubs:{c|const type_<u.name>_<c.name>Key = () => <u.name;format="lsc">.<c.name>Key.type();};separator="\n">
<u.enumerations:{e|const type_<u.name>_<e.name> = () => <u.name;format="lsc">.<e.name>.type();};separator="\n">
<u.structures:{s|const type_<u.name>_<s.name> = () => <u.name;format="lsc">.<s.name>.type();};separator="\n">
>>

vec(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.elementTypeSuffix>(), <v.size>);%>
mat(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.elementTypeSuffix>(), <v.columns>, <v.rows>);%>
element(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.elementTypeSuffix>());%>
map(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.keyTypeSuffix>(), type<v.elementTypeSuffix>());%>
tuple(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>([<v.members:member();separator=", ">]);%>
variant(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>([<v.members:member();separator=", ">]);%>
member(t) ::= <%type<t.typeSuffix>()%>

bound(v, factory) ::= <%export const <v.bindingType.proxy> = <factory>(type<v.typeSuffix>);%>
