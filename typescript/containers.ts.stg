import "banner.stg"

model(m) ::= <<
<banner(m)>

import dsviper from "@digitalsubstrate/dsviper";

import { declare, fixedOf, mappingOf, matrixOf, optionalOf, orderedOf, setOf, variantOf, vectorOf } from "./_codegen/container.js";
import type * as containers from "./containers.js";
import type { AnyConceptKey, AnyValue } from "./_codegen/registry.js";
<m.nameSpaces:{u|import * as <u.name;format="lsc"> from "./<u.name;format="lsc">/data.js";};separator="\n">

<primitives()>
<m.nameSpaces:named();separator="\n">

<m.vecFunctions:vec();separator="\n">
<m.matFunctions:mat();separator="\n">
<m.tupleFunctions:tuple();separator="\n">
<m.optionalFunctions:element();separator="\n">
<m.vectorFunctions:element();separator="\n">
<m.setFunctions:element();separator="\n">
<m.mapFunctions:map();separator="\n">
<m.xarrayFunctions:element();separator="\n">
<m.variantFunctions:variant();separator="\n">

<m.vecFunctions:{v|<bound(v, {fixedOf\<<v.bindingElementType.qualified>, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.matFunctions:{v|<bound(v, {matrixOf\<<v.bindingElementType.qualified>, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.tupleFunctions:{v|<bound(v, {fixedOf\<<v.members:{t|<t.bindingType.qualified>};separator=" | ">, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.optionalFunctions:{v|<bound(v, {optionalOf\<<v.bindingElementType.qualified>, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.vectorFunctions:{v|<bound(v, {vectorOf\<<v.bindingElementType.qualified>, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.setFunctions:{v|<bound(v, {setOf\<<v.bindingElementType.qualified>, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.mapFunctions:{v|<bound(v, {mappingOf\<<v.bindingKeyType.qualified>, <v.bindingElementType.qualified>, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.xarrayFunctions:{v|<bound(v, {orderedOf\<<v.bindingElementType.qualified>, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>})>};separator="\n">
<m.variantFunctions:variant_class();separator="\n\n">

>>

primitives() ::= <<
const type_bool = () => dsviper.Type.BOOL;
const type_uint8 = () => dsviper.Type.UINT8;
const type_uint16 = () => dsviper.Type.UINT16;
const type_uint32 = () => dsviper.Type.UINT32;
const type_uint64 = () => dsviper.Type.UINT64;
const type_int8 = () => dsviper.Type.INT8;
const type_int16 = () => dsviper.Type.INT16;
const type_int32 = () => dsviper.Type.INT32;
const type_int64 = () => dsviper.Type.INT64;
const type_float = () => dsviper.Type.FLOAT;
const type_double = () => dsviper.Type.DOUBLE;
const type_string = () => dsviper.Type.STRING;
const type_blob = () => dsviper.Type.BLOB;
const type_blob_id = () => dsviper.Type.BLOB_ID;
const type_commit_id = () => dsviper.Type.COMMIT_ID;
const type_uuid = () => dsviper.Type.UUID;
const type_any = () => dsviper.Type.ANY;
const type_AnyConceptKey = () => new dsviper.TypeKey(dsviper.Type.ANY_CONCEPT);
>>

named(u) ::= <<
<u.concepts:{c|const type_<u.name>_<c.name>Key = () => <u.name;format="lsc">.<c.name>Key.type();};separator="\n">
<u.clubs:{c|const type_<u.name>_<c.name>Key = () => <u.name;format="lsc">.<c.name>Key.type();};separator="\n">
<u.enumerations:{e|const type_<u.name>_<e.name> = () => <u.name;format="lsc">.<e.name>.type();};separator="\n">
<u.structures:{s|const type_<u.name>_<s.name> = () => <u.name;format="lsc">.<s.name>.type();};separator="\n">
>>

vec(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.elementTypeSuffix>(), <v.size>);%>
mat(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.elementTypeSuffix>(), <v.columns>, <v.rows>);%>
element(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.elementTypeSuffix>());%>
map(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>(type<v.keyTypeSuffix>(), type<v.elementTypeSuffix>());%>
tuple(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>([<v.members:member();separator=", ">]);%>
variant(v) ::= <%const type<v.typeSuffix> = () => new dsviper.<v.viperType>([<v.members:member();separator=", ">]);%>
member(t) ::= <%type<t.typeSuffix>()%>

bound(v, factory) ::= <<
export const <v.bindingType.proxy> = <factory>(type<v.typeSuffix>, "<v.bindingType.proxy>");
export type <v.bindingType.proxy> = InstanceType\<typeof <v.bindingType.proxy>\>;
>>

variant_class(v) ::= <<
const <v.bindingType.proxy>_base = variantOf\<<v.members:{t|<t.bindingType.qualified>};separator=" | ">, <v.bindingType.constructorInput>, "<v.bindingType.proxy>"\>(type<v.typeSuffix>);

export class <v.bindingType.proxy> extends <v.bindingType.proxy>_base {
    <v.members:alternative();separator="\n\n">
}

declare(type<v.typeSuffix>, <v.bindingType.proxy>);
>>

alternative(t) ::= <<
is<t.bindingType.proxy;format="uf">(): boolean {
    return this.holds(type<t.typeSuffix>());
}

get<t.bindingType.proxy;format="uf">(): <t.bindingType.qualified> {
    return this.as\<<t.bindingType.qualified>\>(type<t.typeSuffix>());
}

set<t.bindingType.proxy;format="uf">(value: <t.bindingType.inputQualified>): void {
    this.wrap(value as never, type<t.typeSuffix>());
}
>>
