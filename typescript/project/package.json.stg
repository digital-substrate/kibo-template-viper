main(m) ::= <<
{
    "name": "<m.namespace>",
    "version": "1.0.0",
    "description": "TypeScript bindings generated by kibo for <m.namespace>",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": ["dist", "src"],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@digitalsubstrate/dsviper": ">=1.2.1 \<1.3.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0"
    },
    "license": "UNLICENSED"
}
>>
