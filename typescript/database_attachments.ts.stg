        const attachment = database.definitions().checkAttachment(<a:runtimeId()>);
        return new <a:docOptional()>(database.get(attachment, key.vprValue));
    },

    set(database: dsviper.Database, key: <a:keyProxy()>, value: <a.documentType.pythonType:dtype()>): void {
        const attachment = database.definitions().checkAttachment(<a:runtimeId()>);
        database.set(attachment, key.vprValue, <a.documentType.pythonType:unwrap("value")>);
    },

    del(database: dsviper.Database, key: <a:keyProxy()>): void {
