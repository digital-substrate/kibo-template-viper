dtype(t) ::= <%<if(t.useProxy)>d.<t.proxy><else><tsLeaf.(t.proxy)><endif>%>
unwrap(t, e) ::= <%<if(t.useProxy)><e>.vprValue<else><e><endif>%>

runtimeId(a) ::= <%md.AttachmentRuntimeIds.<a.namespace>_<a.identifier>%>
keySet(a) ::= <%d.Set_<a.keyType.pythonType.proxy>%>
keyProxy(a) ::= <%d.<a.keyType.pythonType.proxy>%>
docOptional(a) ::= <%d.Optional_<a.documentType.pythonType.proxy>%>

attachment(a) ::= <<
