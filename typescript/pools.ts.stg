import "banner.stg"

model(m) ::= <<
<banner(m)>

/** Every function pool of the model, one namespace each, holding the `Remote` a client calls
 *  through a service. Rendered with the `PoolRemote` feature; a module even when the model has no
 *  function pool. */
export {};
<m.functionPools:pool_export();separator="\n">

>>

pool_export(p) ::= <%export * as <p.name;format="snake"> from "./<p.name;format="snake">/index.js";%>
