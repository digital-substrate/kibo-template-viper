import "banner.stg"

unit(u) ::= <<
<banner(u.model)>

import dsviper from "@digitalsubstrate/dsviper";

import { AttachmentProxy, type Mutating } from "../_codegen/attachment.js";
import type * as containers from "../containers.js";
import { AnyConceptKey, type AnyValue } from "../_codegen/registry.js";
import { definitions } from "../definitions.js";
<u.dependencies.attachments:{d|import * as <d.name;format="snake"> from "../<d.name;format="snake">/data.js";};separator="\n">
import * as <u.name;format="snake"> from "./data.js";
<if(u.attachmentScopes)>

<u.attachmentScopes:by_concept(u);separator="\n\n">
<endif>

>>

by_concept(s, u) ::= <<
<s.attachments:own_class(s);separator="">
export class <s.name> {
<s.attachments:one(s);separator="\n\n">
}
>>

one(a, s) ::= <<
    static readonly <a.name;format="lf"> = new <if(a.documentType.isStructure)><opsClass(a, s)><elseif(a.documentType.field.isNotBox)><opsClass(a, s)><else>AttachmentProxy\<<generics(a, s)>\><endif>(
        dsviper.ValueUUId.create("<a.runtimeId>"),
        definitions, <s.keyType.bindingType.qualified>, <documentClass(a)>);
>>

opsClass(a, s) ::= <%_<s.name>_<a.name;format="lf">%>

own_class(a, s) ::= <%<if(a.documentType.isStructure)><own_class_body(a, s)><elseif(a.documentType.field.isNotBox)><own_class_body(a, s)><endif>%>

own_class_body(a, s) ::= <<
export class <opsClass(a, s)> extends AttachmentProxy\<<generics(a, s)>\> {
    <if(a.documentType.isStructure)><a.documentType.structure.fields:field(s);separator="\n\n"><else><document(a, s)><endif>
}

>>

field(sf, s) ::= <<
set<sf.name;format="uf">(mutating: Mutating, key: <key(s)>, value: <sf.bindingType.inputQualified>): void {
    this.updateField(mutating, key, "<sf.dsmName>", value);
}<if(sf.field.isSet)>

<set_ops(sf.field, s, {"<sf.dsmName>"}, {<sf.name;format="uf">}, sf.name)><elseif(sf.field.isMap)>

<map_ops(sf.field, s, {"<sf.dsmName>"}, {<sf.name;format="uf">}, sf.name)><elseif(sf.field.isXArray)>

<xarray_ops(sf.field, s, {"<sf.dsmName>"}, {<sf.name;format="uf">}, sf.name)><endif>
>>

document(a, s) ::= <%<if(a.documentType.field.isSet)><set_ops(a.documentType.field, s, "undefined", "", false)><elseif(a.documentType.field.isMap)><map_ops(a.documentType.field, s, "undefined", "", false)><elseif(a.documentType.field.isXArray)><xarray_ops(a.documentType.field, s, "undefined", "", false)><endif>%>

key(s) ::= <%<s.keyType.bindingType.qualified>%>

set_ops(t, s, path, suffix, label) ::= <<
union<suffix>(mutating: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.unionInSet(mutating, key, <path>, value);
}

subtract<suffix>(mutating: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.subtractInSet(mutating, key, <path>, value);
}
>>

map_ops(t, s, path, suffix, label) ::= <<
union<suffix>(mutating: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.unionInMap(mutating, key, <path>, value);
}

subtract<suffix>(mutating: Mutating, key: <key(s)>, value: <t.bindingKeySetType.inputQualified>): void {
    this.subtractInMap(mutating, key, <path>, value);
}

update<suffix>(mutating: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.updateInMap(mutating, key, <path>, value);
}
>>

xarray_ops(t, s, path, suffix, label) ::= <<
insert<suffix>(mutating: Mutating, key: <key(s)>, beforePosition: dsviper.ValueUUId, newPosition: dsviper.ValueUUId, value: <t.bindingElementType.inputQualified>): void {
    this.insertInXArray(mutating, key, <path>, beforePosition, newPosition, value);
}

update<suffix>(mutating: Mutating, key: <key(s)>, position: dsviper.ValueUUId, value: <t.bindingElementType.inputQualified>): void {
    this.updateInXArray(mutating, key, <path>, position, value);
}

remove<suffix>(mutating: Mutating, key: <key(s)>, position: dsviper.ValueUUId): void {
    this.removeInXArray(mutating, key, <path>, position);
}
>>

generics(a, s) ::= <%<s.keyType.bindingType.qualified>, <a.documentType.bindingType.qualified>, <s.keyType.bindingKeySetType.qualified>, <a.documentType.bindingType.inputQualified>%>
documentClass(a) ::= <%<if(a.documentType.bindingType.isNamed)><a.documentType.bindingType.qualified><else>undefined<endif>%>
