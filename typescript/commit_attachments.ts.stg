import "banner.stg"

unit(u) ::= <<
<banner(u.model)>

/**
 * The <u.name> attachments in a Commit database: read a state, write by mutations.
 *
 * A read takes a state's attachmentGetting(); a write takes a CommitMutableState's
 * attachmentMutating(): new dsviper.CommitMutableState(dsviper.CommitStateBuilder.initialState(db))
 * for the first commit, CommitStateBuilder.state(db, commitId) to carry on from the last one. The
 * database needs the model first: db.extendDefinitions(definitions()). Nothing is stored until the
 * state is committed: db.commitMutations(label, state), or a CommitStore's dispatch. A Database is
 * the other usage: the unit's database_attachments.
 */

import dsviper from "@digitalsubstrate/dsviper";

import { AttachmentBase, type Getting, type Mutating } from "../_codegen/attachment.js";
import type { Optional } from "../_codegen/container.js";
import type * as containers from "../containers.js";
import { AnyConceptKey, type AnyValue } from "../_codegen/registry.js";
import { definitions } from "../definitions.js";
<u.dependencies.attachmentFields:{d|import * as <d.name;format="snake"> from "../<d.name;format="snake">/data.js";};separator="\n">
import * as <u.name;format="snake"> from "./data.js";
import * as _<u.name;format="snake">_paths from "./paths.js";
<u.dependencies.attachments:{d|import * as _<d.name;format="snake">_paths from "../<d.name;format="snake">/paths.js";};separator="\n">
<if(u.attachmentScopes)>

<u.attachmentScopes:by_concept(u);separator="\n\n">
<endif>

>>

by_concept(s, u) ::= <<
<s.attachments:own_class(s);separator="">
export class <s.name> {
<s.attachments:one(s);separator="\n\n">
}
>>

one(a, s) ::= <<
    static readonly <a.name;format="lf"> = new <opsClass(a, s)>(dsviper.ValueUUId.create("<a.runtimeId>"), definitions);
>>

opsClass(a, s) ::= <%_<s.name>_<a.name;format="lf">%>

own_class(a, s) ::= <<
/** <if(a.hasDocumentation)><a.documentation;format="comment"> <endif>The attachment <a.representation>, in a Commit database. */
export class <opsClass(a, s)> extends AttachmentBase {
    /** Return the keys that hold a document in this state. The set is taken now: a later mutation does not reach it. */
    keys(state: Getting): <keyset(s)> {
        return this.keysIn(state) as <keyset(s)>;
    }

    /** Return true if a document is stored at key in this state. */
    has(state: Getting, key: <key(s)>): boolean {
        return this.hasIn(state, key);
    }

    /**
     * Return the document as an optional. It is a copy: changing it changes nothing; write it
     * back with `set`, or mutate a field.
     */
    get(state: Getting, key: <key(s)>): Optional\<<document(a)>\> {
        return this.getIn(state, key) as Optional\<<document(a)>\>;
    }

    /** Return every [key, document] pair of this state. Each document is a copy, as `get` returns it. */
    enumerate(state: dsviper.AttachmentGetting): [<key(s)>, <document(a)>][] {
        return this.enumerateIn(state) as [<key(s)>, <document(a)>][];
    }

    /**
     * Return [added, removed, different, same], from current, the reference, to other: the keys
     * other holds and current does not, those current holds and other does not, those whose
     * documents differ, those whose documents are equal. For what changed since the last load,
     * pass the last loaded state first.
     */
    diffKeys(current: Getting, other: Getting): [<keyset(s)>, <keyset(s)>, <keyset(s)>, <keyset(s)>] {
        return this.diffKeysOf(current, other) as [<keyset(s)>, <keyset(s)>, <keyset(s)>, <keyset(s)>];
    }

    /**
     * Set the document: one mutation, stored when the state is committed. The document is
     * copied in: changing it afterwards does not reach what was written.
     */
    set(state: Mutating, key: <key(s)>, value: <input(a)>): void {
        this.setInState(state, key, value);
    }

    /**
     * Write only what differs between value and the stored document. recursive computes the
     * difference field by field inside a structure, instead of replacing it whole.
     */
    diff(state: Mutating, key: <key(s)>, value: <input(a)>, recursive = false): void {
        this.diffIn(state, key, value, recursive);
    }
    <if(a.documentType.isStructure)><a.documentType.structure.fields:field(a, s);separator="\n"><elseif(a.documentType.field.isNotBox)><document_ops(a, s)><endif>
}


>>

field(sf, a, s) ::= <<

/**
 * Write value in the field <sf.name;format="lf">. A key that holds no document is left as it
 * is, without a word: set the document first.
 */
set<sf.name;format="uf">(state: Mutating, key: <key(s)>, value: <sf.bindingType.inputQualified>): void {
    this.updateField(state, key, <field_path(sf, a)>, value);
}<if(sf.field.isSet)>

<set_ops(sf.field, s, {<field_path(sf, a)>}, {<sf.name;format="uf">})><elseif(sf.field.isMap)>

<map_ops(sf.field, s, {<field_path(sf, a)>}, {<sf.name;format="uf">})><elseif(sf.field.isXArray)>

<xarray_ops(sf.field, s, {<field_path(sf, a)>}, {<sf.name;format="uf">})><endif>
>>

field_path(sf, a) ::= <%_<a.documentType.structure.namespace;format="snake">_paths.<a.documentType.structure.name>.<sf.name;format="lf">%>

document_ops(a, s) ::= <<

<if(a.documentType.field.isSet)><set_ops(a.documentType.field, s, "undefined", "")><elseif(a.documentType.field.isMap)><map_ops(a.documentType.field, s, "undefined", "")><elseif(a.documentType.field.isXArray)><xarray_ops(a.documentType.field, s, "undefined", "")><endif>
>>

set_ops(t, s, path, suffix) ::= <<
/** Add the elements of value to the set. */
union<suffix>(state: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.unionInSet(state, key, <path>, value);
}

/** Remove the elements of value from the set. */
subtract<suffix>(state: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.subtractInSet(state, key, <path>, value);
}
>>

map_ops(t, s, path, suffix) ::= <<
/** Add the entries of value to the map, replacing the map keys already there. */
union<suffix>(state: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.unionInMap(state, key, <path>, value);
}

/** Remove the entries whose map key is in value. */
subtract<suffix>(state: Mutating, key: <key(s)>, value: <t.bindingKeySetType.inputQualified>): void {
    this.subtractInMap(state, key, <path>, value);
}

/**
 * Update the entries of the map from those of value. Only map keys already there are written;
 * a map key only value carries is ignored: union inserts it.
 */
update<suffix>(state: Mutating, key: <key(s)>, value: <t.bindingType.inputQualified>): void {
    this.updateInMap(state, key, <path>, value);
}
>>

xarray_ops(t, s, path, suffix) ::= <<
/**
 * Insert value at newPosition, before beforePosition. A newPosition the xarray holds, or held
 * before a removal, keeps its place; a beforePosition it does not hold leaves it unchanged.
 */
insert<suffix>(state: Mutating, key: <key(s)>, beforePosition: dsviper.ValueUUId, newPosition: dsviper.ValueUUId, value: <t.bindingElementType.inputQualified>): void {
    this.insertInXArray(state, key, <path>, beforePosition, newPosition, value);
}

/** Write value at position. */
update<suffix>(state: Mutating, key: <key(s)>, position: dsviper.ValueUUId, value: <t.bindingElementType.inputQualified>): void {
    this.updateInXArray(state, key, <path>, position, value);
}

/** Remove position. */
remove<suffix>(state: Mutating, key: <key(s)>, position: dsviper.ValueUUId): void {
    this.removeInXArray(state, key, <path>, position);
}
>>

key(s) ::= <%<s.keyType.bindingType.qualified>%>
keyset(s) ::= <%<s.keyType.bindingKeySetType.qualified>%>
document(a) ::= <%<a.documentType.bindingType.qualified>%>
input(a) ::= <%<a.documentType.bindingType.inputQualified>%>
