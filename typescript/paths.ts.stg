import "banner.stg"

unit(u) ::= <<
<banner(u.model)>

/** The path of every field of <u.name>'s structures, for code that reads or writes a field through
 *  the dynamic API. The field names are in the fields module. */

import dsviper from "@digitalsubstrate/dsviper";

import * as fields from "./fields.js";

<u.structures:structure();separator="\n\n">

>>

structure(s) ::= <<
/** The field paths of <s.name>. */
export abstract class <s.name> {
    <s.fields:{f|static readonly <f.name;format="lf">: dsviper.PathConst = dsviper.Path.fromField(fields.<s.name>.<f.name;format="lf">).const();};separator="\n">
}
>>
