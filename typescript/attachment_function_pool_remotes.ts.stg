tsLeaf ::= [
    "bool": "boolean",
    "uint8": "number", "uint16": "number", "uint32": "number",
    "int8": "number", "int16": "number", "int32": "number",
    "uint64": "bigint", "int64": "bigint",
    "float": "number", "double": "number",
    "string": "string",
    "blob": "dsviper.ValueBlob",
    "blob_id": "dsviper.ValueBlobId",
    "commit_id": "dsviper.ValueCommitId",
    "uuid": "dsviper.ValueUUId",
    "Any": "dsviper.ValueAny",
    "void": "void"
]

valueCtor ::= [
    "bool": "ValueBool",
    "uint8": "ValueUInt8", "uint16": "ValueUInt16", "uint32": "ValueUInt32", "uint64": "ValueUInt64",
    "int8": "ValueInt8", "int16": "ValueInt16", "int32": "ValueInt32", "int64": "ValueInt64",
    "float": "ValueFloat", "double": "ValueDouble",
    "string": "ValueString"
]

dtype(t) ::= <%<if(t.useProxy)>d.<t.proxy><else><tsLeaf.(t.proxy)><endif>%>
dwrap(t, e) ::= <%<if(t.useProxy)>d.<t.proxy>.wrap(<e>)<else><e> as <tsLeaf.(t.proxy)><endif>%>
valueEncode(t, e) ::= <%<if(t.useProxy)><e>.vprValue<elseif(valueCtor.(t.proxy))>new dsviper.<valueCtor.(t.proxy)>(<e>)<else><e><endif>%>
parameter(p) ::= <%<p.name>: <p.pythonType:dtype()>%>
encodeArg(p) ::= <%<p.pythonType:valueEncode(p.name)>%>

pool(po) ::= <<
// <po.name>
export class <po.name;format="uf"> {

    private readonly serviceRemote: dsviper.ServiceRemote;

    constructor(serviceRemote: dsviper.ServiceRemote) {
        this.serviceRemote = serviceRemote;
    }

    isAvailable(): boolean {
        return this.serviceRemote.attachmentFunctionPoolFuncs("<po.name>") !== undefined;
    }

    <po.functions:fp_function(po);separator="\n">
}

>>

fp_function(f, po) ::= <<
<f.name;format="lsc">(attachmentMutating: dsviper.AttachmentMutating<if(f.parameters)>, <f.parameters:parameter();separator=", "><endif>): <f.returnPythonType:dtype()> {
    <if(f.isVoid)>
    this.serviceRemote.attachmentFunctionPoolFunc("<po.name>", "<f.name;format="lsc">").call(attachmentMutating<if(f.parameters)>, <f.parameters:encodeArg();separator=", "><endif>);
    <else>
    const result = this.serviceRemote.attachmentFunctionPoolFunc("<po.name>", "<f.name;format="lsc">").call(attachmentMutating<if(f.parameters)>, <f.parameters:encodeArg();separator=", "><endif>) as unknown as dsviper.OutputValue;
    return <f.returnPythonType:dwrap("result")>;
    <endif>
}
>>
