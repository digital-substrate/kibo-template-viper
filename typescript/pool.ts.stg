import "banner.stg"

pool(p) ::= <<
<preamble(p)>

export class Remote {
    private readonly service: dsviper.ServiceRemote;

    /**
     * The pool as a service carries it: service is a dsviper.ServiceRemote.connect(host, port,
     * new dsviper.Definitions()). isAvailable() says whether the service declares this pool;
     * the connection's own state is service.isClosed().
     */
    constructor(service: dsviper.ServiceRemote) {
        this.service = service;
    }

    isAvailable(): boolean {
        return this.service.functionPoolFuncs(NAME) !== undefined;
    }

<p.functions:remote_call();separator="\n\n">
}

>>

attachment_pool(p) ::= <<
<preamble(p)>

export class Remote {
    private readonly service: dsviper.ServiceRemote;

    /**
     * The pool as a service carries it: service is a dsviper.ServiceRemote.connect(host, port,
     * new dsviper.Definitions()). isAvailable() says whether the service declares this pool;
     * the connection's own state is service.isClosed(). A function that mutates takes an
     * AttachmentMutating, one that reads an AttachmentGetting, as an attachment's operations
     * do: the AttachmentProxy documentation says where each comes from. The state knows the
     * model: one a CommitDatabase extended with the package's definitions() gives, or new
     * dsviper.CommitMutableState(new dsviper.CommitState(definitions())); over other
     * definitions a call fails on an unregistered attachment. The service reads and writes
     * that state in place; nothing is stored until it is committed.
     */
    constructor(service: dsviper.ServiceRemote) {
        this.service = service;
    }

    isAvailable(): boolean {
        return this.service.attachmentFunctionPoolFuncs(NAME) !== undefined;
    }

<p.functions:attachment_remote_call();separator="\n\n">
}

>>

preamble(p) ::= <<
<banner(p.model)>

<if(p.hasDocumentation)>/** <p.documentation;format="comment"> */<endif>
import dsviper from "@digitalsubstrate/dsviper";

import type * as containers from "../containers.js";
import { AnyConceptKey, type AnyValue, unwrap, wrap } from "../_codegen/registry.js";
<p.dependencies.functions:{d|import * as <d.name;format="snake"> from "../<d.name;format="snake">/data.js";};separator="\n">

export const NAME = "<p.dsmName>";
export const UUID = dsviper.ValueUUId.create("<p.uuid>");
>>

remote_call(f) ::= <<
<doc(f)>    <f.name;format="lf">(<f.parameters:parameter();separator=", ">): <ret(f)> {
        <call(f)>
    }
>>

attachment_remote_call(f) ::= <<
<doc(f)>    <f.name;format="lf">(state: dsviper.Attachment<f.interfaceType><if(f.parameters)>, <f.parameters:parameter();separator=", "><endif>): <ret(f)> {
        <attachment_call(f)>
    }
>>

parameter(a) ::= <%<a.name;format="lf">: <a.bindingType.annotation>%>
ret(f) ::= <%<if(f.isVoid)>void<else><f.returnBindingType.annotation><endif>%>
argument(a) ::= <%unwrap(<a.name;format="lf">)%>

call(f) ::= <%<if(f.isVoid)>this.service.functionPoolFunc(NAME, "<f.dsmName>").call(<f.parameters:argument();separator=", ">);<else>return wrap(this.service.functionPoolFunc(NAME, "<f.dsmName>").call(<f.parameters:argument();separator=", ">));<endif>%>
attachment_call(f) ::= <%<if(f.isVoid)>this.service.attachmentFunctionPoolFunc(NAME, "<f.dsmName>").call(state<if(f.parameters)>, <endif><f.parameters:argument();separator=", ">);<else>return wrap(this.service.attachmentFunctionPoolFunc(NAME, "<f.dsmName>").call(state<if(f.parameters)>, <endif><f.parameters:argument();separator=", ">));<endif>%>

doc(f) ::= <<
<if(f.hasDocumentation)>    /** <f.documentation;format="comment"> */
<endif>
>>
