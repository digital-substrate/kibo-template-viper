import "banner.stg"

unit(u) ::= <<
<banner(u.model)>

import dsviper from "@digitalsubstrate/dsviper";

import type * as containers from "../containers.js";
import { Key, Proxy } from "../_codegen/proxy.js";
import { AnyConceptKey, type AnyValue, isKnown, register, setField, wrap } from "../_codegen/registry.js";
import { definitions } from "../definitions.js";
<u.dependencies.types:{d|import * as <d.name;format="lsc"> from "../<d.name;format="lsc">/data.js";};separator="\n">

<u.concepts:runtime_id();separator="\n">
<u.clubs:runtime_id();separator="\n">
<u.enumerations:runtime_id();separator="\n">
<u.structures:runtime_id();separator="\n">
<if(u.concepts)>

<u.concepts:concept(u);separator="\n\n">
<endif>
<if(u.clubs)>

<u.clubs:club(u);separator="\n\n">
<endif>
<if(u.enumerations)>

<u.enumerations:enumeration(u);separator="\n\n">
<endif>
<if(u.structures)>

<u.sortedStructures:structure(u);separator="\n\n">
<endif>

register(<u.concepts:registered_key();separator=", "><if(u.clubs)>, <u.clubs:registered_key();separator=", "><endif><if(u.enumerations)>, <u.enumerations:registered();separator=", "><endif><if(u.structures)>, <u.structures:registered();separator=", "><endif>);

>>

runtime_id(v) ::= <%export const <v.name;format="usc"> = dsviper.ValueUUId.create("<v.runtimeId>");%>
registered(v) ::= <%[<v.name;format="usc">, <v.name>]%>
registered_key(v) ::= <%[<v.name;format="usc">, <v.name>Key]%>

concept(c, u) ::= <<
let <c.name;format="lsc">Concept: dsviper.TypeConcept | undefined;
let <c.name;format="lsc">Type: dsviper.TypeKey | undefined;

<if(c.hasDocumentation)>
/** <c.documentation;format="comment"> */
<endif>
export class <c.name>Key extends Key {
    declare private readonly <c.name;format="lsc">KeyBrand: never;

    static concept(): dsviper.TypeConcept {
        return (<c.name;format="lsc">Concept ??= definitions().checkConcept(<c.name;format="usc">));
    }

    static type(): dsviper.TypeKey {
        return (<c.name;format="lsc">Type ??= new dsviper.TypeKey(<c.name>Key.concept()));
    }

    constructor(identifier?: dsviper.ValueKey | dsviper.ValueUUId | string | null) {
        if (identifier === null) {
            throw new TypeError("null is not an instance identifier");
        }
        if (identifier instanceof dsviper.ValueKey) {
            if (!identifier.type().equals(<c.name>Key.type())) {
                throw new TypeError(
                    `this value is not a <u.name>::<c.name>Key: ${identifier.detailTypeRepresentation()}`);
            }
            super(identifier);
        } else {
            super(dsviper.ValueKey.create(<c.name>Key.concept(), identifier));
        }
    }

    static create(): <c.name>Key {
        return new <c.name>Key(dsviper.ValueUUId.create());
    }

    static wrap(value: dsviper.Value): <c.name>Key {
        return new <c.name>Key(dsviper.ValueKey.cast(value));
    }

    instanceId(): dsviper.ValueUUId {
        return this.vprValue.instanceId();
    }

    runtimeId(): dsviper.ValueUUId {
        return this.vprValue.typeConcept().runtimeId();
    }

    isValid(): boolean {
        return this.vprValue.instanceId().isValid();
    }

    description(): string {
        return `${this.vprValue.instanceId().encoded()}:<u.name>::<c.name>Key${this.held()}`;
    }

    isKnown(): boolean {
        return isKnown(this.vprValue);
    }

<if(c.parent)>
    toParentKey(): <c.parentBindingInNamespace> {
        return new <c.parentBindingInNamespace>(this.vprValue.toParentKey());
    }

<endif>
<c.strictDescendantsInNamespace:{d|<if(d.isLocal)><descendant(d, c)>

<endif>}>
    toAnyConceptKey(): AnyConceptKey {
        return new AnyConceptKey(this.vprValue.toAnyConceptKey());
    }

    static fromAnyConceptKey(key: Proxy\<dsviper.ValueKey> | dsviper.ValueKey): <c.name>Key | undefined {
        const value = key instanceof Proxy ? key.vprValue : key;
        return value.isMember(<c.name>Key.concept())
            ? new <c.name>Key(value.toMemberKey(<c.name>Key.concept())) : undefined;
    }

    static fromKey(key: Proxy\<dsviper.ValueKey> | dsviper.ValueKey): <c.name>Key {
        const found = <c.name>Key.fromAnyConceptKey(key);
        if (found === undefined) {
            const value = key instanceof Proxy ? key.vprValue : key;
            throw new TypeError(`${value.detailTypeRepresentation()} does not designate a <u.name>::<c.name>`);
        }
        return found;
    }

    override toString(): string {
        return this.description();
    }
}
>>

club(c, u) ::= <<
let <c.name;format="lsc">Club: dsviper.TypeClub | undefined;
let <c.name;format="lsc">Type: dsviper.TypeKey | undefined;

export class <c.name>Key extends Key {
    declare private readonly <c.name;format="lsc">KeyBrand: never;

    static club(): dsviper.TypeClub {
        return (<c.name;format="lsc">Club ??= definitions().checkClub(<c.name;format="usc">));
    }

    static type(): dsviper.TypeKey {
        return (<c.name;format="lsc">Type ??= new dsviper.TypeKey(<c.name>Key.club()));
    }

    constructor(key: <c.membersInNamespace:{m|<m.bindingInNamespace> | }>dsviper.ValueKey) {
        const value = key instanceof Proxy ? key.vprValue : key;
        if (value.type().equals(<c.name>Key.type())) {
            super(value);
            return;
        }
        if (!<c.name>Key.club().isMember(value.typeConcept())) {
            throw new TypeError("this key does not designate a member of <u.name>::<c.name>");
        }
        super(value.toClubKey(<c.name>Key.club()));
    }

    static wrap(value: dsviper.Value): <c.name>Key {
        return new <c.name>Key(dsviper.ValueKey.cast(value));
    }

    instanceId(): dsviper.ValueUUId {
        return this.vprValue.instanceId();
    }

    runtimeId(): dsviper.ValueUUId {
        return this.vprValue.typeConcept().runtimeId();
    }

    isValid(): boolean {
        return this.vprValue.instanceId().isValid();
    }

    description(): string {
        return `${this.vprValue.instanceId().encoded()}:<u.name>::<c.name>Key${this.held()}`;
    }

    isKnown(): boolean {
        return isKnown(this.vprValue);
    }

    toAnyConceptKey(): AnyConceptKey {
        return new AnyConceptKey(this.vprValue);
    }

    static fromAnyConceptKey(key: Proxy\<dsviper.ValueKey> | dsviper.ValueKey): <c.name>Key | undefined {
        const value = key instanceof Proxy ? key.vprValue : key;
        return <c.name>Key.club().isMember(value.typeConcept()) ? new <c.name>Key(value) : undefined;
    }

<c.membersInNamespace:club_from(c);separator="\n\n">

<c.membersInNamespace:club_to(c);separator="\n\n">

    override toString(): string {
        return this.description();
    }
}
>>

enumeration(e, u) ::= <<
let <e.name;format="lsc">Type: dsviper.TypeEnumeration | undefined;

<if(e.hasDocumentation)>
/** <e.documentation;format="comment"> */
<endif>
export type <e.name> = <e.members:enumeration_case();separator=" | ">;

export const <e.name> = {
<e.members:enumeration_member();separator=",\n">,

    type(): dsviper.TypeEnumeration {
        return (<e.name;format="lsc">Type ??= definitions().checkEnumeration(<e.name;format="usc">));
    },

    wrap(value: dsviper.Value): <e.name> {
        return dsviper.ValueEnumeration.cast(value).name() as <e.name>;
    },

    fromStr(name: string): <e.name> {
        if (typeof name !== "string") {
            throw new TypeError(`${name} is not a case name`);
        }
        return <e.name>.wrap(new dsviper.ValueEnumeration(<e.name>.type(), name));
    },

    name(held: <e.name>): string {
        return held;
    },

    index(held: <e.name>): number {
        return <e.name>.type().cases().findIndex((c) => c.name() === held);
    },

    value(held: <e.name>): dsviper.ValueEnumeration {
        return new dsviper.ValueEnumeration(<e.name>.type(), held);
    },
};
>>

enumeration_case(m) ::= <%"<m.name>"%>
enumeration_member(m) ::= <<    <m.name;format="usc">: "<m.name>" as const>>

structure(s, u) ::= <<
let <s.name;format="lsc">Type: dsviper.TypeStructure | undefined;

<if(s.hasDocumentation)>
/** <s.documentation;format="comment"> */
<endif>
export interface <s.name>Init {
    <s.fields:{f|<f.name;format="lf">?: <f.bindingType.input>;};separator="\n">
}

const <s.name;format="lsc">Fields: readonly string[] = [<s.fields:{f|"<f.name;format="lf">"};separator=", ">];

export class <s.name> extends Proxy\<dsviper.ValueStructure> {
    declare private readonly <s.name;format="lsc">Brand: never;

    static type(): dsviper.TypeStructure {
        return (<s.name;format="lsc">Type ??= definitions().checkStructure(<s.name;format="usc">));
    }

    constructor(value?: dsviper.ValueStructure | <s.name>Init) {
        if (value instanceof dsviper.ValueStructure) {
            if (!value.type().equals(<s.name>.type())) {
                throw new TypeError("this value is not a <u.name>::<s.name>");
            }
            super(value);
            return;
        }
        super(new dsviper.ValueStructure(<s.name>.type()));
        if (value === undefined) {
            return;
        }
        for (const name of Object.keys(value)) {
            if (!<s.name;format="lsc">Fields.includes(name)) {
                throw new TypeError(`<u.name>::<s.name> has no field ${name}`);
            }
        }
        <s.fields:{f|if (value.<f.name;format="lf"> !== undefined) {
    this.<f.name;format="lf"> = value.<f.name;format="lf">;
\}};separator="\n">
    }

    static wrap(value: dsviper.Value): <s.name> {
        return new <s.name>(dsviper.ValueStructure.cast(value));
    }

<s.fields:field(s);separator="\n\n">
}
>>

field(f, s) ::= <<
<if(f.hasDocumentation)>    /** <f.documentation;format="comment"> */
<endif>
    get <f.name;format="lf">(): <f.bindingType.annotation> {
        <read(f)>
    }

    set <f.name;format="lf">(value: <f.bindingType.input>) {
        <write(f)>
    }
>>

read(f) ::= <%<if(f.bindingType.useProxy)>return wrap(this.vprValue.at("<f.name>", false));<else>return this.vprValue.at("<f.name>") as <f.bindingType.annotation>;<endif>%>
write(f) ::= <%setField(this.vprValue, "<f.name>", value);%>

descendant(d, c) ::= <<
    to<d.asNameInNamespace>Key(): <d.bindingInNamespace> | undefined {
        return this.as(<d.bindingInNamespace>);
    }

    static from<d.asNameInNamespace>Key(key: <d.bindingInNamespace>): <c.name>Key {
        return <c.name>Key.fromKey(key);
    }
>>

club_from(cm, c) ::= <<
    static from<cm.asNameInNamespace>Key(key: <cm.bindingInNamespace>): <c.name>Key {
        return new <c.name>Key(key);
    }
>>

club_to(cm, c) ::= <<
    to<cm.asNameInNamespace>Key(): <cm.bindingInNamespace> | undefined {
        return this.as(<cm.bindingInNamespace>);
    }
>>
