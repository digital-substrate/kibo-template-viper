is<vm.proxy;format="uf">(): boolean {
    return (this.vprValue.unwrap(false) as dsviper.Value).type().equals(mt.type<vm.typeSuffix>());
}

get<vm.proxy;format="uf">(): <vm:tsType()> {
    if (!this.is<vm.proxy;format="uf">()) {
        throw new Error("variant does not hold a <vm:tsType()>");
    }
    return <vm:wrap({this.vprValue.unwrap()})>;
}

set<vm.proxy;format="uf">(value: <vm:tsType()>): void {
    this.vprValue.wrap(<vm:unwrap("value")>, mt.type<vm.typeSuffix>());
}
