import "banner.stg"

unit(u) ::= <<
<banner(u.model)>

import dsviper from "@digitalsubstrate/dsviper";

import type * as containers from "../containers.js";
import { Key, Proxy } from "../_codegen/proxy.js";
import { adopt } from "../_codegen/value.js";
import { AnyConceptKey, type AnyValue, isKnown, register, setField, wrap } from "../_codegen/registry.js";
import { definitions } from "../definitions.js";
<u.dependencies.types:{d|import * as <d.name;format="snake"> from "../<d.name;format="snake">/data.js";};separator="\n">

<u.concepts:runtime_id();separator="\n">
<u.clubs:runtime_id();separator="\n">
<u.enumerations:runtime_id();separator="\n">
<u.structures:runtime_id();separator="\n">
<if(u.concepts)>

<u.concepts:concept(u);separator="\n\n">
<endif>
<if(u.clubs)>

<u.clubs:club(u);separator="\n\n">
<endif>
<if(u.enumerations)>

<u.enumerations:enumeration(u);separator="\n\n">
<endif>
<if(u.structures)>

<u.sortedStructures:structure(u);separator="\n\n">
<endif>

register(<u.concepts:registered_key();separator=", "><if(u.clubs)>, <u.clubs:registered_key();separator=", "><endif><if(u.enumerations)>, <u.enumerations:registered();separator=", "><endif><if(u.structures)>, <u.structures:registered();separator=", "><endif>);

>>

runtime_id(v) ::= <%export const <v.name;format="usnake"> = dsviper.ValueUUId.create("<v.runtimeId>");%>
registered(v) ::= <%[<v.name;format="usnake">, <v.name>]%>
registered_key(v) ::= <%[<v.name;format="usnake">, <v.name>Key]%>

concept(c, u) ::= <<
let <c.name;format="snake">Concept: dsviper.TypeConcept | undefined;
let <c.name;format="snake">Type: dsviper.TypeKey | undefined;

<if(c.hasDocumentation)>
/** <c.documentation;format="comment"> */
<endif>
export class <c.name>Key extends Key {
    declare private readonly <c.name;format="snake">KeyBrand: never;

    static concept(): dsviper.TypeConcept {
        return (<c.name;format="snake">Concept ??= definitions().checkConcept(<c.name;format="usnake">));
    }

    static type(): dsviper.TypeKey {
        return (<c.name;format="snake">Type ??= new dsviper.TypeKey(<c.name>Key.concept()));
    }

    /**
     * No argument gives the invalid key, an instance identifier the key of that instance, an
     * instance identifier and a runtime id the key of a concept that is a <c.name> or descends
     * from it. A key of another concept is converted with its `toParentKey()` or
     * `toAnyConceptKey()`, and back with `fromAnyConceptKey()`.
     */
    constructor(identifier?: dsviper.ValueKey | dsviper.ValueUUId | string, runtimeId?: dsviper.ValueUUId | string) {
        if (identifier === null) {
            throw new TypeError("null is not an instance identifier");
        }
        if (identifier instanceof dsviper.ValueKey) {
            if (runtimeId !== undefined) {
                throw new TypeError("a key carries its runtime id");
            }
            if (!identifier.type().equals(<c.name>Key.type())) {
                throw new TypeError(
                    `this value is not a <u.name>::<c.name>Key: ${identifier.detailTypeRepresentation()}`);
            }
            super(identifier);
        } else if (identifier === undefined) {
            if (runtimeId !== undefined) {
                throw new TypeError("a runtime id needs an instance identifier");
            }
            super(dsviper.ValueKey.create(<c.name>Key.concept(), dsviper.ValueUUId.INVALID));
        } else if (runtimeId === undefined) {
            super(dsviper.ValueKey.create(<c.name>Key.concept(), identifier));
        } else {
            const concept = definitions().checkConcept(new dsviper.ValueUUId(runtimeId));
            const key = dsviper.ValueKey.create(concept, identifier);
            if (!key.isMember(<c.name>Key.concept())) {
                throw new TypeError(`${concept.representation()} is not a <u.name>::<c.name>`);
            }
            super(key.toMemberKey(<c.name>Key.concept()));
        }
    }

    static create(): <c.name>Key {
        return new <c.name>Key(dsviper.ValueUUId.create());
    }

    /** The key a Viper value of exactly this type holds; another type throws TypeError. */
    static wrapValue(value: dsviper.Value): <c.name>Key {
        if (!(value instanceof dsviper.Value) || !value.type().equals(<c.name>Key.type())) {
            throw new TypeError(`this value is not a ${<c.name>Key.type().representation()}`);
        }
        return new <c.name>Key(dsviper.ValueKey.cast(value));
    }

    instanceId(): dsviper.ValueUUId {
        return this.unwrapValue().instanceId();
    }

    runtimeId(): dsviper.ValueUUId {
        return this.unwrapValue().typeConcept().runtimeId();
    }

    isValid(): boolean {
        return this.unwrapValue().instanceId().isValid();
    }

    description(): string {
        return `${this.unwrapValue().instanceId().encoded()}:<u.name>::<c.name>Key${this.held()}`;
    }

    isKnown(): boolean {
        return isKnown(this.unwrapValue());
    }

<if(c.parent)>
    toParentKey(): <c.parentBindingInNamespace> {
        return new <c.parentBindingInNamespace>(this.unwrapValue().toParentKey());
    }

<endif>
<c.strictDescendantsInNamespace:{d|<if(d.isLocal)><descendant(d, c)>

<endif>}>
    toAnyConceptKey(): AnyConceptKey {
        return new AnyConceptKey(this.unwrapValue().toAnyConceptKey());
    }

    static fromAnyConceptKey(key: Proxy\<dsviper.ValueKey> | dsviper.ValueKey): <c.name>Key | undefined {
        const value = key instanceof Proxy ? key.unwrapValue() : key;
        return value.isMember(<c.name>Key.concept())
            ? new <c.name>Key(value.toMemberKey(<c.name>Key.concept())) : undefined;
    }

    override toString(): string {
        return this.description();
    }
}
>>

club(c, u) ::= <<
let <c.name;format="snake">Club: dsviper.TypeClub | undefined;
let <c.name;format="snake">Type: dsviper.TypeKey | undefined;

<if(c.hasDocumentation)>
/** <c.documentation;format="comment"> */
<endif>
export class <c.name>Key extends Key {
    declare private readonly <c.name;format="snake">KeyBrand: never;

    static club(): dsviper.TypeClub {
        return (<c.name;format="snake">Club ??= definitions().checkClub(<c.name;format="usnake">));
    }

    static type(): dsviper.TypeKey {
        return (<c.name;format="snake">Type ??= new dsviper.TypeKey(<c.name>Key.club()));
    }

    /** A key of a member, or an instance identifier and the runtime id of a member. */
    constructor(key: <c.name>Key | <c.membersInNamespace:{m|<m.bindingInNamespace> | }>dsviper.ValueKey | dsviper.ValueUUId | string,
                runtimeId?: dsviper.ValueUUId | string) {
        if (!(key instanceof Proxy) && !(key instanceof dsviper.ValueKey)) {
            if (runtimeId === undefined) {
                throw new TypeError("an instance identifier needs the runtime id of a member of <u.name>::<c.name>");
            }
            key = dsviper.ValueKey.create(definitions().checkConcept(new dsviper.ValueUUId(runtimeId)), key);
        } else if (runtimeId !== undefined) {
            throw new TypeError("a key carries its runtime id");
        }
        const value = key instanceof Proxy ? key.unwrapValue() : key;
        if (value.type().equals(<c.name>Key.type())) {
            super(value);
            return;
        }
        if (!<c.name>Key.club().isMember(value.typeConcept())) {
            throw new TypeError("this key does not designate a member of <u.name>::<c.name>");
        }
        super(value.toClubKey(<c.name>Key.club()));
    }

    /** The key a Viper value of exactly this type holds; another type throws TypeError. */
    static wrapValue(value: dsviper.Value): <c.name>Key {
        if (!(value instanceof dsviper.Value) || !value.type().equals(<c.name>Key.type())) {
            throw new TypeError(`this value is not a ${<c.name>Key.type().representation()}`);
        }
        return new <c.name>Key(dsviper.ValueKey.cast(value));
    }

    instanceId(): dsviper.ValueUUId {
        return this.unwrapValue().instanceId();
    }

    runtimeId(): dsviper.ValueUUId {
        return this.unwrapValue().typeConcept().runtimeId();
    }

    isValid(): boolean {
        return this.unwrapValue().instanceId().isValid();
    }

    description(): string {
        return `${this.unwrapValue().instanceId().encoded()}:<u.name>::<c.name>Key${this.held()}`;
    }

    isKnown(): boolean {
        return isKnown(this.unwrapValue());
    }

    toAnyConceptKey(): AnyConceptKey {
        return new AnyConceptKey(this.unwrapValue());
    }

    static fromAnyConceptKey(key: Proxy\<dsviper.ValueKey> | dsviper.ValueKey): <c.name>Key | undefined {
        const value = key instanceof Proxy ? key.unwrapValue() : key;
        return <c.name>Key.club().isMember(value.typeConcept()) ? new <c.name>Key(value) : undefined;
    }

<c.membersInNamespace:club_from(c);separator="\n\n">

<c.membersInNamespace:club_to(c);separator="\n\n">

    override toString(): string {
        return this.description();
    }
}
>>

enumeration(e, u) ::= <<
let <e.name;format="snake">Type: dsviper.TypeEnumeration | undefined;

<if(e.hasDocumentation)>
/** <e.documentation;format="comment"> */
<endif>
export type <e.name> = <e.members:enumeration_case();separator=" | ">;

export const <e.name> = {
<e.members:enumeration_member();separator=",\n">,

    type(): dsviper.TypeEnumeration {
        return (<e.name;format="snake">Type ??= definitions().checkEnumeration(<e.name;format="usnake">));
    },

    /** The case a Viper value of exactly this enumeration holds; another type throws TypeError. */
    wrapValue(value: dsviper.Value): <e.name> {
        if (!(value instanceof dsviper.Value) || !value.type().equals(<e.name>.type())) {
            throw new TypeError(`this value is not a ${<e.name>.type().representation()}`);
        }
        return dsviper.ValueEnumeration.cast(value).name() as <e.name>;
    },

    /** Return the case the model names `name`, spelled as the DSM spells it: `fromStr("<first(e.members):{c|<c.name>}>")`
     *  is `<e.name>.<first(e.members):{c|<c.name;format="usnake">}>`. An unknown name throws ViperError. */
    fromStr(name: string): <e.name> {
        if (typeof name !== "string") {
            throw new TypeError(`${name} is not a case name`);
        }
        return <e.name>.wrapValue(new dsviper.ValueEnumeration(<e.name>.type(), name));
    },

    index(held: <e.name>): number {
        return <e.name>.type().cases().findIndex((c) => c.name() === held);
    },

    unwrapValue(held: <e.name>): dsviper.ValueEnumeration {
        return new dsviper.ValueEnumeration(<e.name>.type(), held);
    },
};
>>

enumeration_case(m) ::= <%"<m.name>"%>
enumeration_member(m) ::= <<    <m.name;format="usnake">: "<m.name>" as const>>

structure(s, u) ::= <<
let <s.name;format="snake">Type: dsviper.TypeStructure | undefined;

export interface <s.name>Init {
    <s.fields:{f|<f.name;format="lf">?: <f.bindingType.input>;};separator="\n">
}

const <s.name;format="snake">Fields: readonly string[] = [<s.fields:{f|"<f.name;format="lf">"};separator=", ">];

<if(s.hasDocumentation)>
/** <s.documentation;format="comment"> */
<endif>
export class <s.name> extends Proxy\<dsviper.ValueStructure> {
    declare private readonly <s.name;format="snake">Brand: never;

    static type(): dsviper.TypeStructure {
        return (<s.name;format="snake">Type ??= definitions().checkStructure(<s.name;format="usnake">));
    }

    constructor(value?: dsviper.ValueStructure | <s.name>Init) {
        if (value instanceof dsviper.ValueStructure) {
            if (!value.type().equals(<s.name>.type())) {
                throw new TypeError("this value is not a <u.name>::<s.name>");
            }
            super(value);
            return;
        }
        super(new dsviper.ValueStructure(<s.name>.type()));
        if (value === undefined) {
            return;
        }
        for (const name of Object.keys(value)) {
            if (!<s.name;format="snake">Fields.includes(name)) {
                throw new TypeError(`<u.name>::<s.name> has no field ${name}`);
            }
        }
        <s.fields:{f|if (value.<f.name;format="lf"> !== undefined) {
    this.<f.name;format="lf"> = value.<f.name;format="lf">;
\}};separator="\n">
    }

    /**
     * The structure over a Viper value of exactly its type, without copying it: a change made
     * through one shows in the other. The constructor boxes such a value the same way; copy it
     * explicitly (`new <s.name>(value.copy())`). Another type throws TypeError.
     */
    static wrapValue(value: dsviper.Value): <s.name> {
        if (!(value instanceof dsviper.Value) || !value.type().equals(<s.name>.type())) {
            throw new TypeError(`this value is not a ${<s.name>.type().representation()}`);
        }
        return adopt(<s.name>, dsviper.ValueStructure.cast(value));
    }

<s.fields:field(s);separator="\n\n">
}
>>

field(f, s) ::= <<
<if(f.hasDocumentation)>    /** <f.documentation;format="comment"> */
<endif>
    get <f.name;format="lf">(): <f.bindingType.annotation> {
        <read(f)>
    }

    set <f.name;format="lf">(value: <f.bindingType.input>) {
        <write(f)>
    }
>>

read(f) ::= <%<if(f.bindingType.useProxy)>return wrap(this.unwrapValue().at("<f.name>", false));<else>return this.unwrapValue().at("<f.name>") as <f.bindingType.annotation>;<endif>%>
write(f) ::= <%setField(this.unwrapValue(), "<f.name>", value);%>

descendant(d, c) ::= <<
    to<d.asNameInNamespace>Key(): <d.bindingInNamespace> | undefined {
        return <d.bindingInNamespace>.fromAnyConceptKey(this);
    }

    static from<d.asNameInNamespace>Key(key: <d.bindingInNamespace>): <c.name>Key {
        if (!(key instanceof <d.bindingInNamespace>)) {
            throw new TypeError(`${String(key)} is not a <d.bindingInNamespace>`);
        }
        return new <c.name>Key(key.unwrapValue().toMemberKey(<c.name>Key.concept()));
    }
>>

club_from(cm, c) ::= <<
    static from<cm.asNameInNamespace>Key(key: <cm.bindingInNamespace>): <c.name>Key {
        return new <c.name>Key(key);
    }
>>

club_to(cm, c) ::= <<
    to<cm.asNameInNamespace>Key(): <cm.bindingInNamespace> | undefined {
        return <cm.bindingInNamespace>.fromAnyConceptKey(this);
    }
>>
