import "banner.stg"

model(m) ::= <<
<banner(m)>

from __future__ import annotations

import functools
import typing

import dsviper

from . import definitions
from ._codegen import AnyValue, Declared, Fixed, Mapping, Matrix, Optional, Ordered, SetView, Variant, Vector, declare

if typing.TYPE_CHECKING:
    from . import containers
    from ._codegen import AnyConceptKey

<primitives()>
<m.nameSpaces:named(m);separator="\n">

<m.vecFunctions:vec();separator="\n">
<m.matFunctions:mat();separator="\n">
<m.tupleFunctions:tuple();separator="\n">
<m.optionalFunctions:element();separator="\n">
<m.vectorFunctions:element();separator="\n">
<m.setFunctions:element();separator="\n">
<m.mapFunctions:map();separator="\n">
<m.xarrayFunctions:element();separator="\n">
<m.variantFunctions:variant();separator="\n">

<m.vecFunctions:fixed_class();separator="\n\n">
<m.matFunctions:matrix_class();separator="\n\n">
<m.tupleFunctions:tuple_class();separator="\n\n">
<m.optionalFunctions:optional_class();separator="\n\n">
<m.vectorFunctions:vector_class();separator="\n\n">
<m.setFunctions:set_class();separator="\n\n">
<m.mapFunctions:mapping_class();separator="\n\n">
<m.xarrayFunctions:ordered_class();separator="\n\n">
<m.variantFunctions:variant_class();separator="\n\n">

<m.nameSpaces:{u|from . import <u.name;format="snake">  # noqa: E402};separator="\n">

declare(<[m.vecFunctions, m.matFunctions, m.tupleFunctions, m.optionalFunctions, m.vectorFunctions, m.setFunctions, m.mapFunctions, m.xarrayFunctions, m.variantFunctions]:{v|<v.bindingType.proxy>};separator=", ">)

>>

primitives() ::= <<
def type_bool() -> dsviper.TypeBool: return dsviper.TypeBool()
def type_uint8() -> dsviper.TypeUInt8: return dsviper.TypeUInt8()
def type_uint16() -> dsviper.TypeUInt16: return dsviper.TypeUInt16()
def type_uint32() -> dsviper.TypeUInt32: return dsviper.TypeUInt32()
def type_uint64() -> dsviper.TypeUInt64: return dsviper.TypeUInt64()
def type_int8() -> dsviper.TypeInt8: return dsviper.TypeInt8()
def type_int16() -> dsviper.TypeInt16: return dsviper.TypeInt16()
def type_int32() -> dsviper.TypeInt32: return dsviper.TypeInt32()
def type_int64() -> dsviper.TypeInt64: return dsviper.TypeInt64()
def type_float() -> dsviper.TypeFloat: return dsviper.TypeFloat()
def type_double() -> dsviper.TypeDouble: return dsviper.TypeDouble()
def type_string() -> dsviper.TypeString: return dsviper.TypeString()
def type_blob() -> dsviper.TypeBlob: return dsviper.TypeBlob()
def type_blob_id() -> dsviper.TypeBlobId: return dsviper.TypeBlobId()
def type_commit_id() -> dsviper.TypeCommitId: return dsviper.TypeCommitId()
def type_uuid() -> dsviper.TypeUUId: return dsviper.TypeUUId()
def type_any() -> dsviper.TypeAny: return dsviper.TypeAny()
def type_AnyConceptKey() -> dsviper.TypeKey: return dsviper.TypeKey(dsviper.TypeAnyConcept())
>>

named(u, m) ::= <<
<u.concepts:{c|def type_<u.name>_<c.name>Key() -> dsviper.Type: return dsviper.TypeKey(definitions().check_concept(<u.name;format="snake">.data.<c.name;format="usnake">))};separator="\n">
<u.clubs:{c|def type_<u.name>_<c.name>Key() -> dsviper.Type: return dsviper.TypeKey(definitions().check_club(<u.name;format="snake">.data.<c.name;format="usnake">))};separator="\n">
<u.enumerations:{e|def type_<u.name>_<e.name>() -> dsviper.Type: return definitions().check_enumeration(<u.name;format="snake">.data.<e.name;format="usnake">)};separator="\n">
<u.structures:{s|def type_<u.name>_<s.name>() -> dsviper.Type: return definitions().check_structure(<u.name;format="snake">.data.<s.name;format="usnake">)};separator="\n">
>>

vec(v) ::= <%@functools.cache<\n>def type<v.typeSuffix>() -> dsviper.Type: return dsviper.<v.viperType>(type<v.elementTypeSuffix>(), <v.size>)%>
mat(v) ::= <%@functools.cache<\n>def type<v.typeSuffix>() -> dsviper.Type: return dsviper.<v.viperType>(type<v.elementTypeSuffix>(), <v.columns>, <v.rows>)%>
element(v) ::= <%@functools.cache<\n>def type<v.typeSuffix>() -> dsviper.Type: return dsviper.<v.viperType>(type<v.elementTypeSuffix>())%>
map(v) ::= <%@functools.cache<\n>def type<v.typeSuffix>() -> dsviper.Type: return dsviper.<v.viperType>(type<v.keyTypeSuffix>(), type<v.elementTypeSuffix>())%>
tuple(v) ::= <%@functools.cache<\n>def type<v.typeSuffix>() -> dsviper.Type: return dsviper.<v.viperType>([<v.members:member();separator=", ">])%>
variant(v) ::= <%@functools.cache<\n>def type<v.typeSuffix>() -> dsviper.Type: return dsviper.<v.viperType>([<v.members:member();separator=", ">])%>
member(t) ::= <%type<t.typeSuffix>()%>

vector_class(v) ::= <<
<declared(v, {Vector["<v.bindingElementType.qualified>"]}, "ValueVector")>
>>
set_class(v) ::= <<
<declared(v, {SetView["<v.bindingElementType.qualified>"]}, "ValueSet")>
>>
fixed_class(v) ::= <<
<declared(v, {Fixed[dsviper.ValueVec, "<v.bindingElementType.qualified>"]}, "ValueVec")>
>>
matrix_class(v) ::= <<
<declared(v, {Matrix["<v.bindingElementType.qualified>"]}, "ValueMat")>
>>
tuple_class(v) ::= <<
<declared(v, {Fixed[dsviper.ValueTuple, "<v.members:{t|<t.bindingType.qualified>};separator=" | ">"]}, "ValueTuple")>

<v.members:{t|<tuple_getter(t, i0)>};separator="\n\n">
>>

tuple_getter(t, index) ::= <<
    def get_<index>(self) -> <t.bindingType.qualified>:
        return typing.cast("<t.bindingType.qualified>", self[<index>])
>>
optional_class(v) ::= <<
<declared(v, {Optional["<v.bindingElementType.qualified>"]}, "ValueOptional")>
>>
mapping_class(v) ::= <<
<declared(v, {Mapping["<v.bindingKeyType.qualified>", "<v.bindingElementType.qualified>"]}, "ValueMap")>
>>
ordered_class(v) ::= <<
<declared(v, {Ordered["<v.bindingElementType.qualified>"]}, "ValueXArray")>
>>
variant_class(v) ::= <<
<declared(v, {Variant["<v.members:{t|<t.bindingType.qualified>};separator=" | ">"]}, "ValueVariant")>

<v.members:alternative();separator="\n\n">
>>

alternative(t) ::= <<
    def is_<t.bindingType.proxy>(self) -> bool:
        return self._holds(type<t.typeSuffix>())

    def get_<t.bindingType.proxy>(self) -> <t.bindingType.qualified>:
        return typing.cast("<t.bindingType.qualified>", self._get(type<t.typeSuffix>()))

    def set_<t.bindingType.proxy>(self, value: <t.bindingType.inputQualified>) -> None:
        self._set(type<t.typeSuffix>(), value)
>>

declared(v, base, value) ::= <<
class <v.bindingType.proxy>(Declared, <base>):
    __slots__ = ()

    def __init__(self, value: <v.bindingType.proxy> | dsviper.<value><if(v.bindingType.constructorInput)> | <v.bindingType.constructorInput><else> | None<endif> = None) -> None:
        super().__init__(value)

    @classmethod
    def type(cls) -> dsviper.Type:
        return type<v.typeSuffix>()
>>
