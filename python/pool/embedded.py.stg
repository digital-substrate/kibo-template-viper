import "../banner.stg"
import "../pool_common.stg"

pool(p) ::= <<
<banner(p.model)>

<preamble(p)>

class Pool:
    """The pool a host application exposes to its embedded Python. From a client of a
    service, the pool's remote module."""

    __slots__ = ("_funcs",)

    NAME = "<p.dsmName>"
    UUID = dsviper.ValueUUId.create("<p.uuid>")

    def __init__(self, pool: dsviper.FunctionPool):
        """pool comes from the C++ host: the wheel cannot build one."""
        self._funcs = pool.funcs

<p.functions:function();separator="\n\n">

>>
