import "../pool_common.stg"

attachment_pool(p) ::= <<
<preamble(p)>

class Remote:
    """The attachment pool as a service carries it, for a client. A function that mutates takes
    a CommitAttachmentMutating, one that reads an AttachmentGetting, as the package's
    commit_attachments do. The state knows the model: one a CommitDatabase extended with the
    package's definitions() gives, or dsviper.CommitMutableState(dsviper.CommitState(definitions()));
    over other definitions a call fails on an unregistered attachment. The service reads and
    writes that state in place; nothing is stored until it is committed. In the host's embedded
    Python, the pool's embedded module."""

    __slots__ = ("_queried",)

    NAME = "<p.dsmName>"
    UUID = dsviper.ValueUUId.create("<p.uuid>")

    def __init__(self, service: dsviper.ServiceRemote):
        """service is a dsviper.ServiceRemote.connect(host, port, dsviper.Definitions()), the
        port given as a string ("54321"). is_available() says whether the service declares this
        pool; the connection's own state is service.is_closed()."""
        self._queried = service.attachment_function_pool_funcs(Remote.NAME)

    def is_available(self) -> bool:
        return self._queried is not None

    @property
    def _funcs(self) -> typing.Any:
        if self._queried is None:
            raise RuntimeError(f"the service does not carry the pool {Remote.NAME}")
        return self._queried

<p.functions:attachment_function();separator="\n\n">

>>
