import "banner.stg"

pool(p) ::= <<
<preamble(p)>

class Pool:

    __slots__ = ("_funcs",)

    NAME = "<p.name>"
    UUID = dsviper.ValueUUId.create("<p.uuid>")

    def __init__(self, pool: dsviper.FunctionPool):
        """The pool a host application exposes to its embedded Python: the
        dsviper.FunctionPool comes from that C++ host, the wheel cannot build one.
        From a client, use Remote."""
        self._funcs = pool.funcs

<p.functions:function();separator="\n\n">

class Remote:

    __slots__ = ("_queried",)

    def __init__(self, service: dsviper.ServiceRemote):
        """The pool as a service carries it: service is a
        dsviper.ServiceRemote.connect(host, port, dsviper.Definitions()). is_available()
        says whether the service declares this pool; the connection's own state is
        service.is_closed()."""
        self._queried = service.function_pool_funcs(Pool.NAME)

    def is_available(self) -> bool:
        return self._queried is not None

    @property
    def _funcs(self) -> typing.Any:
        if self._queried is None:
            raise RuntimeError(f"the service does not carry the pool {Pool.NAME}")
        return self._queried

<p.functions:function();separator="\n\n">

>>

attachment_pool(p) ::= <<
<preamble(p)>

class Pool:

    __slots__ = ("_funcs",)

    NAME = "<p.name>"
    UUID = dsviper.ValueUUId.create("<p.uuid>")

    def __init__(self, pool: dsviper.AttachmentFunctionPool):
        """The pool a host application exposes to its embedded Python: the
        dsviper.AttachmentFunctionPool comes from that C++ host, the wheel cannot build one.
        From a client, use Remote."""
        self._funcs = pool.funcs

<p.functions:attachment_function();separator="\n\n">

class Remote:

    __slots__ = ("_queried",)

    def __init__(self, service: dsviper.ServiceRemote):
        """The pool as a service carries it: service is a
        dsviper.ServiceRemote.connect(host, port, dsviper.Definitions()). is_available()
        says whether the service declares this pool; the connection's own state is
        service.is_closed(). A function that mutates takes an AttachmentMutating, one that
        reads an AttachmentGetting, as an attachment's operations do: their docstring says
        where each comes from. The state knows the model: one a CommitDatabase extended with
        the package's definitions() gives, or dsviper.CommitMutableState(dsviper.CommitState(
        definitions())); over other definitions a call fails on an unregistered attachment.
        The service reads and writes that state in place; nothing is stored until it is
        committed."""
        self._queried = service.attachment_function_pool_funcs(Pool.NAME)

    def is_available(self) -> bool:
        return self._queried is not None

    @property
    def _funcs(self) -> typing.Any:
        if self._queried is None:
            raise RuntimeError(f"the service does not carry the pool {Pool.NAME}")
        return self._queried

<p.functions:attachment_function();separator="\n\n">

>>

preamble(p) ::= <<
<banner(p.model)>

<if(p.hasDocumentation)>"""<p.documentation;format="docstring">"""<endif>

from __future__ import annotations

import typing

import dsviper

from .._codegen import AnyConceptKey, AnyValue, unwrap, wrap

if typing.TYPE_CHECKING:
    from .. import containers

<p.dependencies.functions:{d|from .. import <d.name;format="snake">};separator="\n">
>>

function(f) ::= <<
    def <f.name;format="snake">(self<if(f.parameters)>, <f.parameters:parameter();separator=", "><endif>) -> <ret(f)>:
<doc(f)>        <call(f)>
>>

doc(f) ::= <<
<if(f.hasDocumentation)>        """<f.documentation;format="docstring">"""
<endif>
>>

attachment_function(f) ::= <<
    def <f.name;format="snake">(self, attachment_<f.interfaceType;format="snake">: dsviper.Attachment<f.interfaceType><if(f.parameters)>, <f.parameters:parameter();separator=", "><endif>) -> <ret(f)>:
<doc(f)>        <attachment_call(f)>
>>

parameter(a) ::= <%<a.name;format="snake">: <hint(a.bindingType)>%>
ret(f) ::= <%<if(f.isVoid)>None<else><hint(f.returnBindingType)><endif>%>
argument(a) ::= <%<if(a.bindingType.useProxy)>unwrap(<a.name;format="snake">)<else><a.name;format="snake"><endif>%>

call(f) ::= <%<if(f.isVoid)>self._funcs["<f.name>"](<f.parameters:argument();separator=", ">)<else>return <wrap(f)>self._funcs["<f.name>"](<f.parameters:argument();separator=", ">)<unwrap(f)><endif>%>
attachment_call(f) ::= <%<attachment_invoke(f, {attachment_<f.interfaceType;format="snake">})>%>
attachment_invoke(f, context) ::= <%<if(f.isVoid)>self._funcs["<f.name>"](<context><if(f.parameters)>, <endif><f.parameters:argument();separator=", ">)<else>return <wrap(f)>self._funcs["<f.name>"](<context><if(f.parameters)>, <endif><f.parameters:argument();separator=", ">)<unwrap(f)><endif>%>
wrap(f) ::= <%typing.cast("<ret(f)>", wrap(%>
unwrap(f) ::= <%))%>

hint(b) ::= <%<b.annotation>%>
